<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>nLink</AssemblyName>
    <RootNamespace>NLink.App</RootNamespace>
    <Product>nLink</Product>
    <PackageId>nLink.App</PackageId>
    <ApplicationIcon>Assets\avalonia-logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <PropertyGroup>
    <IsWindows Condition="'$(OS)' == 'Windows_NT'">true</IsWindows>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Screenshare\Capture\Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindows)' == 'true'">
    <Compile Include="Screenshare\Capture\Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindows)' == 'true'">
    <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
    <PackageReference Include="Microsoft.Windows.SDK.NET" Version="10.0.18362.6-preview" />
    <PackageReference Include="Sdcb.FFmpeg.runtime.windows-x64" Version="7.1.0" GeneratePathProperty="true" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindows)' == 'true'">
    <NLinkWindowsFfmpegRuntime Include="$(PkgSdcb_FFmpeg_runtime_windows-x64)\runtimes\win-x64\native\avcodec-61.dll" />
    <NLinkWindowsFfmpegRuntime Include="$(PkgSdcb_FFmpeg_runtime_windows-x64)\runtimes\win-x64\native\avutil-59.dll" />
    <NLinkWindowsFfmpegRuntime Include="$(PkgSdcb_FFmpeg_runtime_windows-x64)\runtimes\win-x64\native\swscale-8.dll" />
    <NLinkWindowsFfmpegRuntime Include="$(PkgSdcb_FFmpeg_runtime_windows-x64)\runtimes\win-x64\native\swresample-5.dll" />
  </ItemGroup>

  <Target Name="CopyNLinkWindowsFfmpegRuntimeToBuildOutput"
          AfterTargets="Build"
          Condition="'$(IsWindows)' == 'true' and '@(NLinkWindowsFfmpegRuntime)' != '' and '$(TargetDir)' != ''">
    <MakeDir Directories="$(TargetDir)ffmpeg" />
    <Copy SourceFiles="@(NLinkWindowsFfmpegRuntime)"
          DestinationFiles="@(NLinkWindowsFfmpegRuntime->'$(TargetDir)ffmpeg\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNLinkWindowsFfmpegRuntimeToPublishOutput"
          AfterTargets="Publish"
          Condition="'$(IsWindows)' == 'true' and '@(NLinkWindowsFfmpegRuntime)' != '' and '$(PublishDir)' != ''">
    <MakeDir Directories="$(PublishDir)ffmpeg" />
    <Copy SourceFiles="@(NLinkWindowsFfmpegRuntime)"
          DestinationFiles="@(NLinkWindowsFfmpegRuntime->'$(PublishDir)ffmpeg\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\nLink.Core\nLink.Core.csproj" />
    <ProjectReference Include="..\nLink.Infra.DevLocal\nLink.Infra.DevLocal.csproj" />
    <ProjectReference Include="..\nLink.Infra.Nkn\nLink.Infra.Nkn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NLink.SmokeTests.Contracts</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NLink.SmokeTests.Core</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NLink.SmokeTests.Gui</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NLink.SmokeTests.RemoteControl</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NLink.SmokeTests.ScreenShare</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>NLink.TestCommon</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

