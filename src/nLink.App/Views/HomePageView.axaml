<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.HomePageView"
             x:DataType="vm:HomePageViewModel">

    <UserControl.Styles>
        <Style Selector="Border.choiceCard">
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style Selector="Border.helperChoiceCard">
            <Setter Property="BorderBrush" Value="#F2C94C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.choiceButton">
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

        <Style Selector="Button.helperChoiceButton">
            <Setter Property="Background" Value="#F2C94C"/>
            <Setter Property="Foreground" Value="#0B0F16"/>
            <Setter Property="BorderBrush" Value="#EAB308"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="28">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="720"
                        Spacing="16">
                <TextBlock Classes="appTitle"
                           Text="{Binding AppTitle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Classes="appBody"
                           Text="{Binding Subtitle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           MaxWidth="620"
                           Margin="0,0,0,6"/>

                <Border Classes="appPanel"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        IsVisible="{Binding ShowStartupWarning}">
                    <TextBlock Text="{Binding StartupWarningText}"
                               Classes="appBody"
                               FontSize="16"
                               TextAlignment="Center"/>
                </Border>

                <Border Classes="appPanel"
                        CornerRadius="12"
                        Padding="14">
                    <StackPanel Spacing="14">
                        <Border Classes="appCard choiceCard">
                            <StackPanel Spacing="10">
                                <Button Classes="appButton choiceButton primaryButton"
                                        Content="{Binding NeedHelpLabel}"
                                        Command="{Binding NeedHelpCommand}"/>

                                <TextBlock Classes="appBody"
                                           Text="{Binding NeedHelpDescription}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           MaxWidth="560"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="appCard choiceCard helperChoiceCard">
                            <StackPanel Spacing="10">
                                <Button Classes="appButton choiceButton helperChoiceButton"
                                        Content="{Binding WantToHelpLabel}"
                                        Command="{Binding WantToHelpCommand}"/>

                                <TextBlock Classes="appBody"
                                           Text="{Binding WantToHelpDescription}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           MaxWidth="560"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Button Classes="linkButton linkAction"
                        Content="Options"
                        Command="{Binding DiagnosticsCommand}"
                        HorizontalAlignment="Center"
                        Padding="10,6"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
