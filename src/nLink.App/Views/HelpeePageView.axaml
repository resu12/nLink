<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.HelpeePageView"
             x:DataType="vm:HelpeePageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.highContrastInput">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="24">
            <StackPanel HorizontalAlignment="Center"
                        MaxWidth="720"
                        Spacing="16">

                <TextBlock Classes="appTitle"
                           Text="{Binding PageTitle}"
                           IsVisible="{Binding ShowPageHeader}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Classes="appBody"
                           Text="{Binding PageSubtitle}"
                           IsVisible="{Binding ShowPageSubtitle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           MaxWidth="560"/>

                <Border Classes="appCard"
                        Padding="24">
                    <StackPanel Spacing="16">
                        <views:StatusBanner Status="{Binding BannerStatus}"
                                            ForceVisible="{Binding ShowStatusBanner}"
                                            CopyDiagnosticsCommand="{Binding StatusBannerCopyDiagnosticsCommand}"
                                            CancelCommand="{Binding StatusBannerCancelCommand}"
                                            FailureCategory="{Binding StatusBannerFailureCategory}"
                                            SessionCorrelationId="{Binding StatusBannerSessionCorrelationId}"
                                            LastConnectDuration="{Binding StatusBannerLastConnectDuration}"
                                            LastHandshakeDuration="{Binding StatusBannerLastHandshakeDuration}"
                                            BridgeState="{Binding StatusBannerBridgeState}"/>

                        <!-- State A: waiting/hosting -->
                        <StackPanel Spacing="16"
                                    IsVisible="{Binding ShowWaitingPanel}">
                            <Border Background="{StaticResource AppMutedPanelBrush}"
                                    BorderBrush="{StaticResource AppCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20"
                                    Cursor="Hand"
                                    PointerPressed="ShareCodeBorder_PointerPressed">
                                <TextBlock Classes="codeDigits"
                                           Text="{Binding ShareCode}"
                                           AutomationProperties.AutomationId="Helpee.Code"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10"
                                  IsVisible="{Binding ShowWaitingCodeActions}">
                                <Button Grid.Column="0"
                                        AutomationProperties.AutomationId="Helpee.CopyCode"
                                        Classes="appButton primaryButton action"
                                        Content="Copy code"
                                        Command="{Binding CopyCodeCommand}"
                                        HorizontalAlignment="Stretch"/>

                                <Button Grid.Column="1"
                                        AutomationProperties.AutomationId="Helpee.NewCode"
                                        Classes="appButton secondaryButton action"
                                        Content="New code"
                                        Command="{Binding RegenerateCodeCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>

                            <TextBlock Classes="appMuted"
                                       Text="{Binding CopyFeedback.Text}"
                                       FontSize="14"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding CopyFeedback.IsVisible}"/>

                            <Button Classes="appButton secondaryButton action"
                                    Content="Retry"
                                    Command="{Binding RetryCommand}"
                                    IsVisible="{Binding ShowRetryAction}"/>

                            <TextBlock Classes="appMuted"
                                       AutomationProperties.AutomationId="Helpee.Status"
                                       Text="{Binding StatusLineText}"
                                       FontSize="15"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding ShowWaitingStatusLine}"/>
                        </StackPanel>

                        <!-- State B: incoming request -->
                        <StackPanel Spacing="16"
                                    IsVisible="{Binding ShowIncomingRequestPanel}">
                            <TextBlock Text="{Binding IncomingHelperName}"
                                       Foreground="{StaticResource AppTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Classes="appBody"
                                       AutomationProperties.AutomationId="Helpee.Status"
                                       Text="{Binding StatusLineText}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <Button Classes="appButton positiveButton action"
                                    AutomationProperties.AutomationId="Helpee.Allow"
                                    Content="Allow"
                                    Command="{Binding AllowCommand}"
                                    IsEnabled="{Binding HasIncomingRequest}"/>

                            <Button Classes="appButton secondaryButton action"
                                    AutomationProperties.AutomationId="Helpee.Decline"
                                    Content="Decline"
                                    Command="{Binding DeclineCommand}"
                                    IsEnabled="{Binding HasIncomingRequest}"/>
                        </StackPanel>

                        <!-- State C: connected -->
                        <StackPanel Spacing="16"
                                    IsVisible="{Binding ShowConnectedPanel}">
                            <Border HorizontalAlignment="Center"
                                    MinWidth="560"
                                    MaxWidth="720">
                                <views:ChatView HorizontalAlignment="Stretch"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Classes="linkButton"
                        Content="Open diagnostics"
                        Command="{Binding OpenDiagnosticsCommand}"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding ShowOpenDiagnosticsLink}"/>

                <Button Classes="appButton secondaryButton"
                        Content="Back"
                        Command="{Binding CancelCommand}"
                        Height="44"
                        MinWidth="180"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding ShowBackButton}"/>

                <StackPanel Spacing="8"
                            HorizontalAlignment="Center"
                            MaxWidth="720"
                            IsVisible="{Binding ShowDevTroubleshooting}">
                    <Button Classes="linkButton"
                            Content="Troubleshooting"
                            Command="{Binding ToggleTroubleshootingCommand}"
                            HorizontalAlignment="Center"
                            FontSize="14"/>

                    <Border Classes="appCard"
                            CornerRadius="10"
                            Padding="12"
                            IsVisible="{Binding ShowTroubleshooting}">
                        <Button Classes="appButton secondaryButton"
                                Content="Test incoming request"
                                Command="{Binding SimulateIncomingRequestCommand}"
                                Height="40"
                                MinWidth="240"
                                FontSize="15"
                                HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
