<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.HelpeePageView"
             x:DataType="vm:HelpeePageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.highContrastInput">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="24">
            <StackPanel HorizontalAlignment="Center"
                        MaxWidth="720"
                        Spacing="14">

                <TextBlock Classes="appTitle"
                           Text="{Binding PageTitle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Classes="appBody"
                           Text="{Binding PageSubtitle}"
                           IsVisible="{Binding IsWaitingView}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           MaxWidth="560"/>

                <Border Classes="appCard"
                        Padding="24">
                    <StackPanel Spacing="16">

                        <!-- State A: waiting/hosting -->
                        <StackPanel Spacing="14"
                                    IsVisible="{Binding IsWaitingView}">
                            <Border Background="{StaticResource AppMutedPanelBrush}"
                                    BorderBrush="{StaticResource AppCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="20"
                                    Cursor="Hand"
                                    PointerPressed="ShareCodeBorder_PointerPressed">
                                <TextBlock Text="{Binding ShareCode}"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource AppTextBrush}"
                                           FontFamily="Cascadia Mono,Consolas,Monaco,monospace"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           LetterSpacing="6"
                                           TextAlignment="Center"/>
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        HorizontalAlignment="Stretch">
                                <Button Classes="appButton primaryButton action"
                                        Content="Copy code"
                                        Command="{Binding CopyCodeCommand}"
                                        HorizontalAlignment="Stretch"
                                        Width="340"/>

                                <Button Classes="appButton secondaryButton action"
                                        Content="New code"
                                        Command="{Binding RegenerateCodeCommand}"
                                        HorizontalAlignment="Stretch"
                                        Width="340"/>
                            </StackPanel>

                            <TextBlock Classes="appMuted"
                                       Text="{Binding StatusLineText}"
                                       FontSize="15"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- State B: incoming request -->
                        <StackPanel Spacing="14"
                                    IsVisible="{Binding IsIncomingRequestView}">
                            <TextBlock Text="{Binding IncomingHelperName}"
                                       Foreground="{StaticResource AppTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Classes="appBody"
                                       Text="{Binding StatusLineText}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>

                            <Button Classes="appButton primaryButton action"
                                    Content="Allow"
                                    Command="{Binding AllowCommand}"
                                    IsEnabled="{Binding HasIncomingRequest}"/>

                            <Button Classes="appButton secondaryButton action"
                                    Content="Decline"
                                    Command="{Binding DeclineCommand}"
                                    IsEnabled="{Binding HasIncomingRequest}"/>
                        </StackPanel>

                        <!-- State C: connected -->
                        <StackPanel Spacing="12"
                                    IsVisible="{Binding ShowChatSection}">
                            <Border Classes="appPanel"
                                    Padding="12">
                                <TextBlock Classes="appBody"
                                           Text="{Binding ConnectionStatus}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Border HorizontalAlignment="Center"
                                    MinWidth="560"
                                    MaxWidth="720">
                                <views:ChatView HorizontalAlignment="Stretch"/>
                            </Border>

                            <Button Classes="appButton secondaryButton action"
                                    Content="Disconnect"
                                    Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Classes="appButton secondaryButton"
                        Content="Back"
                        Command="{Binding CancelCommand}"
                        Height="44"
                        MinWidth="180"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding ShowBackButton}"/>

                <StackPanel Spacing="8"
                            HorizontalAlignment="Center"
                            MaxWidth="720"
                            IsVisible="{Binding ShowDevTroubleshooting}">
                    <Button Classes="linkButton"
                            Content="Troubleshooting"
                            Command="{Binding ToggleTroubleshootingCommand}"
                            HorizontalAlignment="Center"
                            FontSize="14"/>

                    <Border Classes="appCard"
                            CornerRadius="10"
                            Padding="12"
                            IsVisible="{Binding ShowTroubleshooting}">
                        <Button Classes="appButton secondaryButton"
                                Content="Test incoming request"
                                Command="{Binding SimulateIncomingRequestCommand}"
                                Height="40"
                                MinWidth="240"
                                FontSize="15"
                                HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
