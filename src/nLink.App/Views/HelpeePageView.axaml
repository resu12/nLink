<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.HelpeePageView"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             x:DataType="vm:HelpeePageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.highContrastInput">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style Selector="Button.inviteAction">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

        <Style Selector="Button.linkAction">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style Selector="Button.backAction">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>

        <Style Selector="Border.inlineBadge">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.inlineBadgeText">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Margin="24">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="8">

                <views:SessionShellView RoleText="Helpee"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ShowScreenShareAction="True"
                                        ShowChatPaneRequested="{Binding ShowConnectedPanel}">
                    <views:SessionShellView.MainContent>
                        <Grid>
                            <views:ScreenShareSurfaceView Frame="{Binding ScreenSharePreviewFrame}"
                                                          IsVisible="{Binding ShowScreenSharePreviewFrame}"/>

                            <Border IsVisible="{Binding ShowRemoteControlPreviewActiveCue}"
                                    IsHitTestVisible="False"
                                    Margin="2"
                                    BorderBrush="{StaticResource AppTextBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Opacity="0.5"/>

                            <StackPanel IsVisible="{Binding ShowRemoteControlDebugToggle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="12"
                                        Spacing="6"
                                        MaxWidth="320">
                                <Button Classes="appButton secondaryButton"
                                        Content="{Binding RemoteControlDebugToggleText}"
                                        Command="{Binding ToggleRemoteControlDebugPanelCommand}"
                                        MinWidth="148"
                                        Height="28"
                                        HorizontalAlignment="Right"/>
                                <Border IsVisible="{Binding ShowRemoteControlDebugOverlay}"
                                        Padding="10"
                                        Background="#CC111A24"
                                        BorderBrush="{StaticResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Remote control diagnostics"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsRoleText, StringFormat='role: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsControlStateText, StringFormat='state: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsControlModeText, StringFormat='control mode: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsDisplayText, StringFormat='display: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsCaptureFrameText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsMoveStatsText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsSuppressionsText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsLastMappedText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Classes="appPanel"
                                    IsVisible="{Binding ShowRemoteControlAdminWarning}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    MaxWidth="640"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding RemoteControlAdminWarningText}"
                                               Classes="appMuted"
                                               TextWrapping="Wrap"/>
                                    <Button Classes="appButton secondaryButton"
                                            Content="Restart as administrator"
                                            Command="{Binding RestartAsAdministratorCommand}"
                                            IsEnabled="{Binding CanRestartAsAdministrator}"
                                            HorizontalAlignment="Left"
                                            MinWidth="220"
                                            Height="34"/>
                                </StackPanel>
                            </Border>

                            <Border Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsVisible="{Binding ShowHelpeeMainContent}"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="620"
                                    MinWidth="620">
                                <StackPanel Spacing="18">
                                    <views:StatusBanner Status="{Binding BannerStatus}"
                                                        ForceVisible="{Binding ShowStatusBanner}"
                                                        DetailsText="{Binding StatusBannerDetailsText}"
                                                        CancelCommand="{Binding StatusBannerCancelCommand}"
                                                        FailureCategory="{Binding StatusBannerFailureCategory}"
                                                        SessionCorrelationId="{Binding StatusBannerSessionCorrelationId}"
                                                        LastConnectDuration="{Binding StatusBannerLastConnectDuration}"
                                                        LastHandshakeDuration="{Binding StatusBannerLastHandshakeDuration}"
                                                        BridgeState="{Binding StatusBannerBridgeState}"/>

                                    <Border Classes="appPanel"
                                            Padding="10"
                                            IsVisible="{Binding ShowTransientStatusPanel}">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <TextBlock Text="{Binding TransientBannerText}"
                                                       Classes="appMuted"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Classes="appButton secondaryButton"
                                                    Content="Cancel"
                                                    Command="{Binding CancelTransientCommand}"
                                                    IsVisible="{Binding CanCancelTransient}"
                                                    IsEnabled="{Binding CanCancelTransient}"
                                                    Height="34"
                                                    MinWidth="88"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource AppMutedPanelBrush}"
                                            CornerRadius="18"
                                            Padding="24,14,24,24"
                                            IsVisible="{Binding ShowWaitingPanel}">
                                        <StackPanel Spacing="16"
                                                    HorizontalAlignment="Stretch">
                                            <Border Background="{StaticResource AppSurfaceBrush}"
                                                    CornerRadius="16"
                                                    Padding="16"
                                                    HorizontalAlignment="Stretch">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="10">
                                                        <TextBlock Text="Enter helper address"
                                                                   Foreground="{StaticResource AppTextBrush}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1"
                                                                Classes="inlineBadge"
                                                                IsVisible="{Binding ShowFirstPillVerificationCode}">
                                                            <TextBlock Classes="inlineBadgeText"
                                                                       AutomationProperties.AutomationId="Helpee.FirstPillVerificationCode"
                                                                       Text="{Binding FirstPillVerificationCodeText}"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBox Classes="appInput highContrastInput"
                                                             AutomationProperties.AutomationId="Helpee.HelperIdentityInput"
                                                             Text="{Binding InviteHelperIdentityInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             KeyDown="InviteHelperIdentityInput_KeyDown"
                                                             Watermark="Enter helper address or import helper QR"
                                                             IsEnabled="{Binding CanStartOrConnect}"/>
                                                    <Grid ColumnDefinitions="*,*"
                                                          ColumnSpacing="10">
                                                        <Button Grid.Column="0"
                                                                Classes="appButton secondaryButton inviteAction"
                                                                Content="Paste helper address"
                                                                Click="PasteHelperId_Click"/>
                                                        <Button Grid.Column="1"
                                                                x:Name="ImportQrMenuButton"
                                                                Classes="appButton secondaryButton inviteAction"
                                                                Content="Import QR"
                                                                Click="OpenImportQrMenu_Click">
                                                            <Button.ContextMenu>
                                                                <ContextMenu x:Name="ImportQrContextMenu"
                                                                             Placement="Bottom">
                                                                    <MenuItem Header="Import from file"
                                                                              Click="ImportHelperQr_Click"/>
                                                                    <MenuItem x:Name="ScanHelperQrMenuItem"
                                                                              Header="Scan with camera"
                                                                              Click="ScanHelperQr_Click"/>
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </Grid>
                                                    <StackPanel Spacing="10"
                                                                HorizontalAlignment="Center"
                                                                MaxWidth="380">
                                                        <Grid ColumnDefinitions="Auto,Auto"
                                                              ColumnSpacing="10"
                                                              HorizontalAlignment="Center"
                                                              IsVisible="{Binding ShowShareInviteExpiry}">
                                                            <TextBlock Text="{Binding ShareInviteExpiryText}"
                                                                       Classes="appMuted"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       TextAlignment="Center"/>
                                                            <Button Grid.Column="1"
                                                                    AutomationProperties.AutomationId="Helpee.RefreshInvite"
                                                                    Classes="linkButton linkAction"
                                                                    Content="Refresh"
                                                                    Command="{Binding RefreshInviteCommand}"
                                                                    IsEnabled="{Binding CanStartOrConnect}"
                                                                     VerticalAlignment="Center"
                                                                     IsVisible="{Binding HasVerifiedInviteHelperIdentity}"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <TextBlock AutomationProperties.AutomationId="Helpee.InviteStatus"
                                                               Text="{Binding ShareInviteStatusText}"
                                                               Classes="appMuted"
                                                               FontSize="13"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               MaxWidth="380"
                                                               IsVisible="{Binding ShowShareInviteStatus}"/>

                                                    <Button AutomationProperties.AutomationId="Helpee.RequestHelp"
                                                            Classes="appButton positiveButton action"
                                                            Content="Request help"
                                                            Command="{Binding RequestHelpCommand}"
                                                            IsEnabled="{Binding CanStartOrConnect}"/>

                                                    <TextBlock Classes="appMuted"
                                                               Text="{Binding CopyFeedback.Text}"
                                                               FontSize="13"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               MaxWidth="380"
                                                               IsVisible="{Binding CopyFeedback.IsVisible}"/>
                                                </StackPanel>
                                            </Border>

                                            <Button Classes="appButton secondaryButton action"
                                                    Content="Retry"
                                                    Command="{Binding RetryCommand}"
                                                    IsEnabled="{Binding CanStartOrConnect}"
                                                    IsVisible="{Binding ShowRetryAction}"/>

                                        </StackPanel>
                                    </Border>

                                        <StackPanel Spacing="14"
                                                    IsVisible="{Binding ShowIncomingRequestPanel}">
                                        <StackPanel Spacing="6">
                                            <TextBlock AutomationProperties.AutomationId="Helpee.IncomingApprovalTitle"
                                                       Text="Allow this helper to connect?"
                                                       Foreground="{StaticResource AppTextBrush}"
                                                       FontSize="21"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       MaxWidth="420"/>
                                            <TextBlock AutomationProperties.AutomationId="Helpee.IncomingApprovalTimer"
                                                       Text="{Binding IncomingRequestTimeoutText}"
                                                       Classes="appMuted"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       IsVisible="{Binding ShowIncomingRequestTimeout}"/>
                                        </StackPanel>

                                        <Border Background="{StaticResource AppSurfaceBrush}"
                                                CornerRadius="12"
                                                Padding="14"
                                                IsVisible="{Binding ShowIncomingRequestedCapabilities}">
                                            <StackPanel Spacing="10">
                                                <StackPanel Spacing="4">
                                                    <TextBlock AutomationProperties.AutomationId="Helpee.RequestedAccessTitle"
                                                               Text="Requested access"
                                                               Foreground="{StaticResource AppTextBrush}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="Choose what to allow in this session."
                                                               Classes="appMuted"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <CheckBox AutomationProperties.AutomationId="Helpee.AllowCapability.Chat"
                                                              Content="Send messages"
                                                              IsChecked="{Binding AllowIncomingChatCapability}"
                                                              IsVisible="{Binding ShowIncomingChatCapability}"/>

                                                    <CheckBox AutomationProperties.AutomationId="Helpee.AllowCapability.ScreenShare"
                                                              Content="View your screen"
                                                              IsChecked="{Binding AllowIncomingScreenShareCapability}"
                                                              IsVisible="{Binding ShowIncomingScreenShareCapability}"/>

                                                    <CheckBox AutomationProperties.AutomationId="Helpee.AllowCapability.RemoteControl"
                                                              Content="Control your mouse and keyboard"
                                                              IsChecked="{Binding AllowIncomingRemoteControlCapability}"
                                                              IsEnabled="{Binding CanAllowIncomingRemoteControlCapability}"
                                                              IsVisible="{Binding ShowIncomingRemoteControlCapability}"/>

                                                    <CheckBox AutomationProperties.AutomationId="Helpee.AllowCapability.FileTransfer"
                                                              Content="Transfer files"
                                                              IsChecked="{Binding AllowIncomingFileTransferCapability}"
                                                              IsVisible="{Binding ShowIncomingFileTransferCapability}"/>

                                                    <CheckBox AutomationProperties.AutomationId="Helpee.AllowCapability.Clipboard"
                                                              Content="Use clipboard"
                                                              IsChecked="{Binding AllowIncomingClipboardCapability}"
                                                              IsVisible="{Binding ShowIncomingClipboardCapability}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="10">
                                            <Button Grid.Column="0"
                                                    Classes="appButton positiveButton action"
                                                    AutomationProperties.AutomationId="Helpee.Allow"
                                                    Content="Allow"
                                                    Command="{Binding AllowCommand}"
                                                    IsEnabled="{Binding CanAllowIncomingRequestAction}"/>

                                            <Button Grid.Column="1"
                                                    Classes="appButton secondaryButton action"
                                                    AutomationProperties.AutomationId="Helpee.Decline"
                                                    Content="Decline"
                                                    Command="{Binding DeclineCommand}"
                                                    IsEnabled="{Binding HasIncomingRequest}"/>
                                        </Grid>
                                    </StackPanel>
                                    </StackPanel>
                            </Border>

                            <Border Background="#7F0B111A"
                                    IsVisible="{Binding ShowRemoteControlConsentDialog}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <Border HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="460"
                                        MinWidth="320"
                                        Padding="20"
                                        Background="{StaticResource AppSurfaceBrush}"
                                        BorderBrush="{StaticResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="{Binding RemoteControlConsentTitle}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"/>

                                        <TextBlock Text="{Binding RemoteControlConsentMessage}"
                                                   Classes="appMuted"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>

                                        <Grid ColumnDefinitions="Auto,Auto"
                                              ColumnSpacing="10"
                                              HorizontalAlignment="Center">
                                            <Button Grid.Column="0"
                                                    Classes="appButton positiveButton"
                                                    AutomationProperties.AutomationId="Helpee.ControlConsent.Allow"
                                                    Content="Allow control"
                                                    Command="{Binding AllowControlConsentCommand}"/>
                                            <Button Grid.Column="1"
                                                    Classes="appButton secondaryButton"
                                                    AutomationProperties.AutomationId="Helpee.ControlConsent.Deny"
                                                    Content="Deny"
                                                    Command="{Binding DenyControlConsentCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>
                    </views:SessionShellView.MainContent>

                    <views:SessionShellView.ChatContent>
                        <Border HorizontalAlignment="Stretch">
                            <views:ChatView HorizontalAlignment="Stretch"/>
                        </Border>
                    </views:SessionShellView.ChatContent>
                </views:SessionShellView>

                <Button Grid.Row="1"
                        Classes="appButton secondaryButton backAction"
                        Content="Back"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding ShowBackButton}"
                        Height="48"
                        MinWidth="200"
                        Opacity="0.92"/>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
