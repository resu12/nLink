<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="NLink.App.Views.DownloadHelperAppWindow"
        Title="Download helper app"
        Width="980"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        Background="#0B0F16">

    <Window.Styles>
        <Style Selector="Button.action">
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
    </Window.Styles>

    <Grid Background="#0B0F16" RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Margin="20,20,20,12"
                Padding="16"
                Background="#111827"
                BorderBrush="White"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel Spacing="6"
                        HorizontalAlignment="Center"
                        MaxWidth="620">
                <TextBlock Text="Download helper app"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Keep this window open during download."
                           Foreground="#E5E7EB"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,0,20,12">
            <Border x:Name="SurfaceBorder"
                    Background="#0F172A"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="6">
                <ContentControl x:Name="WebContentHost"/>
            </Border>

            <Border x:Name="FallbackOverlay"
                    IsVisible="False"
                    Background="#111827"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="560"
                            Spacing="12">
                    <TextBlock x:Name="FallbackTitleText"
                               Text="Opening nFTP in your browser..."
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               TextAlignment="Center"/>

                    <TextBlock x:Name="FallbackMessageText"
                               Text="Embedded web view is not available."
                               Foreground="#E5E7EB"
                               FontSize="16"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <Border Background="#0F172A"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8">
                        <TextBlock Text="https://nftp.nkn.org"
                                   Foreground="#93C5FD"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Button Classes="action"
                            Content="Open nFTP in browser"
                            Click="OpenInBrowser_Click"
                            Width="420"
                            Background="#E5E7EB"
                            Foreground="Black"
                            BorderBrush="#CBD5E1"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="20,0,20,20"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <Button Classes="action"
                    Content="Back"
                    Click="Back_Click"
                    Width="220"
                    Height="48"
                    FontSize="18"
                    Background="#1F2937"
                    Foreground="White"
                    BorderBrush="#475569"/>
        </Border>
    </Grid>
</Window>
