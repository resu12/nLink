<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.ScreenSharePlaceholderView">

    <Grid AutomationProperties.AutomationId="ScreenShare.Viewer"
          ClipToBounds="True">
        <Image AutomationProperties.AutomationId="ScreenShare.Viewer"
               Source="{ReflectionBinding ScreenShareViewer.CurrentFrame}"
               Stretch="Uniform"
               IsVisible="{ReflectionBinding ShowRemoteScreenShareFrame}"/>

        <Image AutomationProperties.AutomationId="ScreenShare.Viewer"
               Source="{ReflectionBinding ScreenSharePreviewFrame}"
               Stretch="Uniform"
               IsVisible="{ReflectionBinding ShowScreenSharePreviewFrame}"/>

        <Border Background="#66000000"
                Padding="12,8"
                Margin="16"
                CornerRadius="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{ReflectionBinding ShowScreenShareViewerError}">
            <TextBlock Text="{ReflectionBinding ScreenShareViewerMessage}"
                       Classes="appStatusText"
                       AutomationProperties.AutomationId="ScreenShare.ViewerMessage"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="360"/>
        </Border>
    </Grid>
</UserControl>
