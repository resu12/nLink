<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.SessionShellView"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="8">
        <views:SessionHeaderView Grid.Row="0"
                                 StatusText="{ReflectionBinding HeaderStatusText}"
                                 EndSessionCommand="{ReflectionBinding EndSessionCommand}"
                                 CanEndSession="{ReflectionBinding CanEndSession}"
                                 ShowEndSession="True"
                                 ShowScreenShare="{Binding #Root.EffectiveShowScreenShareAction}"
                                 ScreenShareCommand="{Binding #Root.ScreenShareCommand}"
                                 ScreenShareButtonText="{Binding #Root.ScreenShareButtonText}"
                                 RoleText="{Binding #Root.RoleText}"
                                 IsVisible="{Binding #Root.UseSessionHeader}"/>

        <Grid x:Name="FixedShellLayout"
              Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16"
              MinHeight="420"
              IsVisible="{Binding #Root.ShowFixedShellLayout}">
            <Border Grid.Column="0"
                    Background="{StaticResource AppMutedPanelBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    MinWidth="320"
                    MinHeight="420">
                <Grid>
                    <views:ScreenSharePlaceholderView IsVisible="{Binding #Root.ShowScreenSharePane}"/>
                    <ContentPresenter x:Name="FixedMainContentPresenter"/>
                    <TextBlock x:Name="ContentPlaceholderText"
                               Text="Content"
                               Classes="appMuted"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    Width="360"
                    MinWidth="320"
                    MaxWidth="420"
                    MinHeight="420">
                <Border.IsVisible>
                    <Binding Path="#Root.ShowChatPane"/>
                </Border.IsVisible>
                <ContentPresenter x:Name="FixedChatContentPresenter"/>
            </Border>
        </Grid>

        <Border x:Name="FixedChatOnlyLayout"
                Grid.Row="1"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Width="360"
                MinWidth="320"
                MaxWidth="420"
                MinHeight="420"
                HorizontalAlignment="Center"
                IsVisible="{Binding #Root.ShowFixedChatOnlyLayout}">
            <ContentPresenter x:Name="FixedChatOnlyContentPresenter"/>
        </Border>

        <Grid x:Name="ResponsiveWideShellLayout"
              Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="16"
              MinHeight="420"
              IsVisible="{Binding #Root.ShowResponsiveWideLayout}">
            <Border Grid.Column="0"
                    Background="{StaticResource AppMutedPanelBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    MinWidth="320"
                    MinHeight="420">
                <Grid>
                    <views:ScreenSharePlaceholderView IsVisible="{Binding #Root.ShowScreenSharePane}"/>
                    <ContentPresenter x:Name="ResponsiveWideMainContentPresenter"/>
                    <TextBlock x:Name="ResponsiveContentPlaceholderText"
                               Text="Content"
                               Classes="appMuted"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          MinWidth="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          IsVisible="{Binding #Root.UseResponsiveLayout}"/>

            <Border Grid.Column="2"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    MinWidth="320"
                    MaxWidth="420"
                    MinHeight="420">
                <Border.IsVisible>
                    <Binding Path="#Root.ShowChatPane"/>
                </Border.IsVisible>
                <ContentPresenter x:Name="ResponsiveWideChatContentPresenter"/>
            </Border>
        </Grid>

        <Border x:Name="ResponsiveWideChatOnlyLayout"
                Grid.Row="1"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                MinWidth="320"
                MaxWidth="420"
                MinHeight="420"
                HorizontalAlignment="Center"
                IsVisible="{Binding #Root.ShowResponsiveWideChatOnlyLayout}">
            <ContentPresenter x:Name="ResponsiveWideChatOnlyContentPresenter"/>
        </Border>

        <Grid x:Name="ResponsiveNarrowShellLayout"
              Grid.Row="1"
              RowDefinitions="*,Auto"
              RowSpacing="16"
              MinHeight="420"
              IsVisible="{Binding #Root.ShowResponsiveNarrowLayout}">
            <Border Grid.Row="0"
                    Background="{StaticResource AppMutedPanelBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    MinWidth="320"
                    MinHeight="420">
                <Grid>
                    <views:ScreenSharePlaceholderView IsVisible="{Binding #Root.ShowScreenSharePane}"/>
                    <ContentPresenter x:Name="ResponsiveNarrowMainContentPresenter"/>
                    <TextBlock x:Name="NarrowContentPlaceholderText"
                               Text="Content"
                               Classes="appMuted"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    MinWidth="320"
                    MaxWidth="420"
                    MinHeight="260">
                <Border.IsVisible>
                    <Binding Path="#Root.ShowChatPane"/>
                </Border.IsVisible>
                <ContentPresenter x:Name="ResponsiveNarrowChatContentPresenter"/>
            </Border>
        </Grid>

        <Border x:Name="ResponsiveNarrowChatOnlyLayout"
                Grid.Row="1"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                MinWidth="320"
                MinHeight="260"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding #Root.ShowResponsiveNarrowChatOnlyLayout}">
            <ContentPresenter x:Name="ResponsiveNarrowChatOnlyContentPresenter"/>
        </Border>
    </Grid>
</UserControl>
