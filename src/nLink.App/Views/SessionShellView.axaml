<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.SessionShellView"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*"
          RowSpacing="8">
        <Border Grid.Row="0"
                HorizontalAlignment="{Binding #Root.MainPaneHorizontalAlignment}"
                MaxWidth="{Binding #Root.MainPaneMaxWidth}"
                IsVisible="{Binding #Root.UseSessionHeader}">
            <views:SessionHeaderView StatusText="{ReflectionBinding HeaderStatusText}"
                                     VerificationCodeText="{ReflectionBinding HeaderVerificationCodeText}"
                                     ShowVerificationCode="{ReflectionBinding ShowHeaderVerificationCode}"
                                     EndSessionCommand="{ReflectionBinding EndSessionCommand}"
                                     CanEndSession="{ReflectionBinding CanEndSession}"
                                     ShowEndSession="True"
                                     ShowRequestControl="{ReflectionBinding ShowRequestControlAction}"
                                     RequestControlCommand="{ReflectionBinding RequestControlCommand}"
                                     CanRequestControl="{ReflectionBinding CanRequestControl}"
                                     ShowScreenShare="{Binding #Root.EffectiveShowScreenShareAction}"
                                     CanScreenShare="{Binding #Root.CanScreenShareAction}"
                                     ScreenShareCommand="{Binding #Root.ScreenShareCommand}"
                                     ScreenShareButtonText="{Binding #Root.ScreenShareButtonText}"
                                     ScreenShareAccessory="{Binding #Root.HeaderAccessory}"
                                     ShowStopControl="{ReflectionBinding ShowStopControlAction}"
                                     StopControlCommand="{ReflectionBinding StopControlCommand}"
                                     StopControlButtonText="{ReflectionBinding StopControlButtonText}"
                                     CanStopControl="{ReflectionBinding CanStopControl}"
                                     ShowControlModeToggle="{ReflectionBinding ShowControlModeToggle}"
                                     ControlModeToggleCommand="{ReflectionBinding ToggleControlModeCommand}"
                                     ControlModeButtonText="{ReflectionBinding ControlModeButtonText}"
                                     CanControlModeToggle="{ReflectionBinding CanControlModeToggle}"
                                     ShowRemoteControlActiveStatus="{ReflectionBinding ShowRemoteControlActiveStatus}"
                                     RoleText="{Binding #Root.RoleText}"
                                     HorizontalAlignment="Stretch"/>
        </Border>

        <Grid x:Name="FixedShellLayout"
              Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="0"
              MinHeight="{Binding #Root.MainPaneMinHeight}"
              IsVisible="{Binding #Root.ShowFixedShellLayout}">
            <!--
                0.3.3 screenshare scaling spec:
                - The screenshare surface fills the full available area of this left pane.
                - Scaling preserves aspect ratio (Stretch=Uniform) and stays centered; letterboxing is allowed.
                - This shell border is the only card frame. The viewer must not add an inner card/border.
                - Viewer error text remains centered and readable over the surface.
                - Transport, frame delivery, and decode behavior do not change.
                Acceptance:
                - Enlarging the window enlarges the visible screenshare surface.
                - No distortion.
                - Behavior is consistent in fixed, responsive-wide, and responsive-narrow shell layouts.
                - Chat-only layouts do not change.
            -->
            <Border Grid.Column="0"
                    Background="{StaticResource AppMutedPanelBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    HorizontalAlignment="{Binding #Root.MainPaneHorizontalAlignment}"
                    VerticalAlignment="Top"
                    MaxWidth="{Binding #Root.MainPaneMaxWidth}"
                    MinWidth="320"
                    MinHeight="{Binding #Root.MainPaneMinHeight}">
                <Grid>
                    <views:ScreenSharePlaceholderView IsVisible="{Binding #Root.ShowScreenSharePane}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                    <ContentPresenter x:Name="FixedMainContentPresenter"/>
                    <TextBlock x:Name="ContentPlaceholderText"
                               Text="Content"
                               Classes="appMuted"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    Margin="16,0,0,0"
                    Width="{Binding #Root.SideBySideChatPaneWidth}"
                    MinWidth="320"
                    MaxWidth="{Binding #Root.SideBySideChatPaneWidth}"
                    MinHeight="420">
                <Border.IsVisible>
                    <Binding Path="#Root.ShowChatPane"/>
                </Border.IsVisible>
                <ContentPresenter x:Name="FixedChatContentPresenter"/>
            </Border>
        </Grid>

        <Border x:Name="FixedChatOnlyLayout"
                Grid.Row="1"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Width="420"
                MinWidth="320"
                MaxWidth="420"
                MinHeight="420"
                HorizontalAlignment="Center"
                IsVisible="{Binding #Root.ShowFixedChatOnlyLayout}">
            <ContentPresenter x:Name="FixedChatOnlyContentPresenter"/>
        </Border>

        <Grid x:Name="ResponsiveWideShellLayout"
              Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="0"
              MinHeight="{Binding #Root.MainPaneMinHeight}"
              IsVisible="{Binding #Root.ShowResponsiveWideLayout}">
            <Border Grid.Column="0"
                    Background="{StaticResource AppMutedPanelBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    HorizontalAlignment="{Binding #Root.MainPaneHorizontalAlignment}"
                    VerticalAlignment="Top"
                    MaxWidth="{Binding #Root.MainPaneMaxWidth}"
                    MinWidth="320"
                    MinHeight="{Binding #Root.MainPaneMinHeight}">
                <Grid>
                    <views:ScreenSharePlaceholderView IsVisible="{Binding #Root.ShowScreenSharePane}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                    <ContentPresenter x:Name="ResponsiveWideMainContentPresenter"/>
                    <TextBlock x:Name="ResponsiveContentPlaceholderText"
                               Text="Content"
                               Classes="appMuted"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          MinWidth="8"
                          Margin="16,0,16,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          IsVisible="{Binding #Root.ShowChatPane}"/>

            <Border Grid.Column="2"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    Width="{Binding #Root.SideBySideChatPaneWidth}"
                    MinWidth="320"
                    MaxWidth="{Binding #Root.SideBySideChatPaneWidth}"
                    MinHeight="420">
                <Border.IsVisible>
                    <Binding Path="#Root.ShowChatPane"/>
                </Border.IsVisible>
                <ContentPresenter x:Name="ResponsiveWideChatContentPresenter"/>
            </Border>
        </Grid>

        <Border x:Name="ResponsiveWideChatOnlyLayout"
                Grid.Row="1"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Width="420"
                MinWidth="320"
                MaxWidth="420"
                MinHeight="420"
                HorizontalAlignment="Center"
                IsVisible="{Binding #Root.ShowResponsiveWideChatOnlyLayout}">
            <ContentPresenter x:Name="ResponsiveWideChatOnlyContentPresenter"/>
        </Border>

        <Grid x:Name="ResponsiveNarrowShellLayout"
              Grid.Row="1"
              RowDefinitions="*,Auto"
              RowSpacing="16"
              MinHeight="{Binding #Root.MainPaneMinHeight}"
              IsVisible="{Binding #Root.ShowResponsiveNarrowLayout}">
            <Border Grid.Row="0"
                    Background="{StaticResource AppMutedPanelBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    HorizontalAlignment="{Binding #Root.MainPaneHorizontalAlignment}"
                    VerticalAlignment="Top"
                    MaxWidth="{Binding #Root.MainPaneMaxWidth}"
                    MinWidth="320"
                    MinHeight="{Binding #Root.MainPaneMinHeight}">
                <Grid>
                    <views:ScreenSharePlaceholderView IsVisible="{Binding #Root.ShowScreenSharePane}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                    <ContentPresenter x:Name="ResponsiveNarrowMainContentPresenter"/>
                    <TextBlock x:Name="NarrowContentPlaceholderText"
                               Text="Content"
                               Classes="appMuted"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    Width="420"
                    MinWidth="320"
                    MaxWidth="420"
                    MinHeight="260">
                <Border.IsVisible>
                    <Binding Path="#Root.ShowChatPane"/>
                </Border.IsVisible>
                <ContentPresenter x:Name="ResponsiveNarrowChatContentPresenter"/>
            </Border>
        </Grid>

        <Border x:Name="ResponsiveNarrowChatOnlyLayout"
                Grid.Row="1"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16"
                Width="420"
                MinWidth="320"
                MaxWidth="420"
                MinHeight="260"
                HorizontalAlignment="Center"
                IsVisible="{Binding #Root.ShowResponsiveNarrowChatOnlyLayout}">
            <ContentPresenter x:Name="ResponsiveNarrowChatOnlyContentPresenter"/>
        </Border>

        <ContentPresenter Grid.Row="0"
                          Grid.RowSpan="2"
                          ZIndex="100"
                          Content="{Binding #Root.OverlayContent}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
