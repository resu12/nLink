<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.RolePageView"
             x:DataType="vm:RolePageViewModel">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Classes="appCard"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="760"
                Margin="32"
                CornerRadius="16"
                Padding="28">
            <StackPanel Spacing="18">
                <TextBlock Classes="appTitle"
                           Text="{Binding Title}"
                           FontSize="34"
                           TextAlignment="Center"/>

                <TextBlock Classes="appBody"
                           Text="{Binding Message}"
                           FontSize="19"
                           TextAlignment="Center"/>

                <Button Classes="appButton secondaryButton"
                        Content="Back"
                        Command="{Binding BackCommand}"
                        Height="64"
                        FontSize="22"
                        HorizontalAlignment="Center"
                        Width="180"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

