<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.SessionHeaderView"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="TextBlock.headerRole">
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style Selector="TextBlock.headerStatus">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style Selector="Border.remoteControlBadge">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.remoteControlBadgeText">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="10"
          MinHeight="38">
        <TextBlock Grid.Column="0"
                   Classes="headerRole"
                   Text="{Binding #Root.RoleText}"
                   IsVisible="{Binding #Root.HasRoleText}"
                   MaxLines="1"/>

        <TextBlock Grid.Column="1"
                   Classes="headerStatus"
                   AutomationProperties.AutomationId="SessionHeader.StatusText"
                   Text="{Binding #Root.StatusText}"
                   HorizontalAlignment="Stretch"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">
            <Border Classes="remoteControlBadge"
                    IsVisible="{Binding #Root.ShowVerificationCode}">
                <TextBlock Classes="remoteControlBadgeText"
                           AutomationProperties.AutomationId="SessionHeader.VerificationCode"
                           Text="{Binding #Root.VerificationCodeText}"
                           IsVisible="{Binding #Root.ShowVerificationCode}"/>
            </Border>

            <Border Classes="remoteControlBadge"
                    IsVisible="{Binding #Root.ShowRemoteControlActiveStatus}">
                <TextBlock Classes="remoteControlBadgeText"
                           AutomationProperties.AutomationId="SessionHeader.RemoteControlActive"
                           Text="Remote control active"/>
            </Border>

            <Button Classes="appButton secondaryButton compactButton"
                    AutomationProperties.AutomationId="SessionHeader.ControlMode"
                    Content="{Binding #Root.ControlModeButtonText}"
                    Command="{Binding #Root.ControlModeToggleCommand}"
                    IsEnabled="{Binding #Root.CanControlModeToggle}"
                    IsVisible="{Binding #Root.ShowControlModeToggle}"
                    HorizontalAlignment="Stretch"
                    MinWidth="144"/>

            <Button Classes="appButton secondaryButton compactButton"
                    AutomationProperties.AutomationId="SessionHeader.RequestControl"
                    Content="Request control"
                    Command="{Binding #Root.RequestControlCommand}"
                    IsEnabled="{Binding #Root.CanRequestControl}"
                    IsVisible="{Binding #Root.ShowRequestControl}"
                    HorizontalAlignment="Stretch"
                    MinWidth="132"/>

            <ContentPresenter Content="{Binding #Root.ScreenShareAccessory}"
                              VerticalAlignment="Center"
                              IsVisible="{Binding #Root.HasScreenShareAccessory}"/>

            <Button x:Name="ShareScreenButton"
                    Classes="appButton secondaryButton compactButton"
                    AutomationProperties.AutomationId="SessionHeader.ShareScreen"
                    Content="{Binding #Root.ScreenShareButtonText}"
                    Command="{Binding #Root.ScreenShareCommand}"
                    IsEnabled="{Binding #Root.CanScreenShare}"
                    IsVisible="{Binding #Root.ShowScreenShare}"
                    HorizontalAlignment="Stretch"
                    MinWidth="132"/>

            <Button Classes="appButton primaryButton compactButton"
                    AutomationProperties.AutomationId="SessionHeader.StopControl"
                    Content="{Binding #Root.StopControlButtonText}"
                    Command="{Binding #Root.StopControlCommand}"
                    IsEnabled="{Binding #Root.CanStopControl}"
                    IsVisible="{Binding #Root.ShowStopControl}"
                    HorizontalAlignment="Stretch"
                    MinWidth="120"/>

            <Button Classes="appButton secondaryButton compactButton"
                    Content="End session"
                    Command="{Binding #Root.EndSessionCommand}"
                    IsEnabled="{Binding #Root.CanEndSession}"
                    IsVisible="{Binding #Root.ShowEndSession}"
                    HorizontalAlignment="Stretch"
                    MinWidth="112"/>
        </StackPanel>
    </Grid>
</UserControl>
