<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.SessionHeaderView"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="TextBlock.headerRole">
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style Selector="TextBlock.headerStatus">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style Selector="Border.remoteControlBadge">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.remoteControlBadgeText">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="10"
          MinHeight="38">
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    IsVisible="{Binding #Root.HasRoleText}">
            <StackPanel Orientation="Horizontal"
                        Spacing="0"
                        VerticalAlignment="Center">
                <Viewbox Width="20"
                         Height="20"
                         VerticalAlignment="Center"
                         ToolTip.Tip="{Binding #Root.TunaPictogramTip}"
                         RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform>
                        <ScaleTransform ScaleX="{Binding #Root.TunaPulseScale}"
                                        ScaleY="{Binding #Root.TunaPulseScale}"/>
                    </Viewbox.RenderTransform>
                    <Canvas Width="24"
                            Height="24">
                        <Ellipse Canvas.Left="0"
                                 Canvas.Top="2"
                                 Width="24"
                                 Height="20"
                                 Fill="{Binding #Root.TunaGlowBrush}"
                                 Opacity="{Binding #Root.TunaGlowOpacity}"/>
                        <Ellipse Canvas.Left="2"
                                 Canvas.Top="4"
                                 Width="20"
                                 Height="16"
                                 Fill="{Binding #Root.TunaGlowBrush}"
                                 Opacity="{Binding #Root.TunaInnerGlowOpacity}"/>
                        <Path Data="M3,12 C6.4,6.7 14.4,6.2 20,12 C14.4,17.8 6.4,17.3 3,12 Z"
                              Fill="{Binding #Root.TunaPictogramBrush}"
                              Opacity="{Binding #Root.TunaPictogramOpacity}"/>
                        <Path Data="M19,12 L23,8 L23,16 Z"
                              Fill="{Binding #Root.TunaPictogramBrush}"
                              Opacity="{Binding #Root.TunaPictogramOpacity}"/>
                        <Path Data="M9,7.6 C10.6,10.2 10.6,13.8 9,16.4"
                              Stroke="{StaticResource AppBackgroundBrush}"
                              StrokeThickness="1.4"
                              StrokeLineCap="Round"
                              Opacity="{Binding #Root.TunaGillOpacity}"/>
                        <Ellipse Canvas.Left="6.4"
                                 Canvas.Top="10.1"
                                 Width="2"
                                 Height="2"
                                 Fill="{StaticResource AppBackgroundBrush}"
                                 Opacity="{Binding #Root.TunaGillOpacity}"/>
                    </Canvas>
                </Viewbox>

                <Button Classes="compactButton"
                        AutomationProperties.AutomationId="SessionHeader.TunaUnlockToggle"
                        Width="30"
                        MinWidth="0"
                        Height="20"
                        Padding="0"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        IsVisible="{Binding #Root.ShowTunaUnlockToggle}"
                        IsEnabled="{Binding #Root.CanTunaUnlockToggle}"
                        ToolTip.Tip="{Binding #Root.TunaUnlockTip}"
                        Click="TunaUnlockToggle_Click">
                    <Grid Width="30"
                          Height="16"
                          ClipToBounds="False">
                        <Border Width="30"
                                Height="16"
                                CornerRadius="8"
                                Background="{Binding #Root.TunaUnlockTrackBrush}"
                                BorderBrush="{StaticResource AppCardBorderBrush}"
                                BorderThickness="1"/>
                        <Ellipse Width="12"
                                 Height="12"
                                 Margin="{Binding #Root.TunaUnlockThumbMargin}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Fill="{Binding #Root.TunaUnlockThumbBrush}"/>
                    </Grid>
                </Button>
            </StackPanel>

            <TextBlock Classes="headerRole"
                       Text="{Binding #Root.RoleText}"
                       MaxLines="1"/>
        </StackPanel>

        <TextBlock Grid.Column="1"
                   Classes="headerStatus"
                   AutomationProperties.AutomationId="SessionHeader.StatusText"
                   Text="{Binding #Root.StatusText}"
                   HorizontalAlignment="Stretch"
                   MaxLines="1"
                   TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">
            <Border Classes="remoteControlBadge"
                    IsVisible="{Binding #Root.ShowVerificationCode}">
                <TextBlock Classes="remoteControlBadgeText"
                           AutomationProperties.AutomationId="SessionHeader.VerificationCode"
                           Text="{Binding #Root.VerificationCodeText}"
                           IsVisible="{Binding #Root.ShowVerificationCode}"/>
            </Border>

            <Border Classes="remoteControlBadge"
                    IsVisible="{Binding #Root.ShowRemoteControlActiveStatus}">
                <TextBlock Classes="remoteControlBadgeText"
                           AutomationProperties.AutomationId="SessionHeader.RemoteControlActive"
                           Text="Remote control active"/>
            </Border>

            <Button Classes="appButton secondaryButton compactButton"
                    AutomationProperties.AutomationId="SessionHeader.ControlMode"
                    Content="{Binding #Root.ControlModeButtonText}"
                    Command="{Binding #Root.ControlModeToggleCommand}"
                    IsEnabled="{Binding #Root.CanControlModeToggle}"
                    IsVisible="{Binding #Root.ShowControlModeToggle}"
                    HorizontalAlignment="Stretch"
                    MinWidth="144"/>

            <Button Classes="appButton secondaryButton compactButton"
                    AutomationProperties.AutomationId="SessionHeader.RequestControl"
                    Content="Request control"
                    Command="{Binding #Root.RequestControlCommand}"
                    IsEnabled="{Binding #Root.CanRequestControl}"
                    IsVisible="{Binding #Root.ShowRequestControl}"
                    HorizontalAlignment="Stretch"
                    MinWidth="132"/>

            <ContentPresenter Content="{Binding #Root.ScreenShareAccessory}"
                              VerticalAlignment="Center"
                              IsVisible="{Binding #Root.HasScreenShareAccessory}"/>

            <Button x:Name="ShareScreenButton"
                    Classes="appButton secondaryButton compactButton"
                    AutomationProperties.AutomationId="SessionHeader.ShareScreen"
                    Content="{Binding #Root.ScreenShareButtonText}"
                    Command="{Binding #Root.ScreenShareCommand}"
                    IsEnabled="{Binding #Root.CanScreenShare}"
                    IsVisible="{Binding #Root.ShowScreenShare}"
                    HorizontalAlignment="Stretch"
                    MinWidth="132"/>

            <Button Classes="appButton primaryButton compactButton"
                    AutomationProperties.AutomationId="SessionHeader.StopControl"
                    Content="{Binding #Root.StopControlButtonText}"
                    Command="{Binding #Root.StopControlCommand}"
                    IsEnabled="{Binding #Root.CanStopControl}"
                    IsVisible="{Binding #Root.ShowStopControl}"
                    HorizontalAlignment="Stretch"
                    MinWidth="120"/>

            <Button Classes="appButton secondaryButton compactButton"
                    Content="End session"
                    Command="{Binding #Root.EndSessionCommand}"
                    IsEnabled="{Binding #Root.CanEndSession}"
                    IsVisible="{Binding #Root.ShowEndSession}"
                    HorizontalAlignment="Stretch"
                    MinWidth="112"/>
        </StackPanel>
    </Grid>
</UserControl>
