<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.HelperPageView"
             x:Name="Root"
             x:DataType="vm:HelperPageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.highContrastInput">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style Selector="Button.primaryAction">
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style Selector="Button.secondaryAction">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <Style Selector="Button.linkAction">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style Selector="Button.backAction">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="24">
            <StackPanel HorizontalAlignment="Center"
                        MaxWidth="1120"
                        Spacing="16">
                <views:SessionShellView RoleText="Helper"
                                        ShowChatPaneRequested="{Binding ShowConnectedPanel}">
                    <views:SessionShellView.MainContent>
                        <Grid>
                            <views:ScreenShareSurfaceView Frame="{Binding RemoteScreenShareFrame}"
                                                          IsVisible="{Binding ShowRemoteScreenShareFrame}"/>

                            <Border Classes="appCard"
                                    Padding="24"
                                    IsVisible="{Binding ShowHelperMainContent}">
                                <StackPanel Spacing="16">
                                    <views:StatusBanner Status="{Binding BannerStatus}"
                                                        ForceVisible="{Binding ShowStatusBanner}"
                                                        DetailsText="{Binding StatusBannerDetailsText}"
                                                        CancelCommand="{Binding StatusBannerCancelCommand}"
                                                        FailureCategory="{Binding StatusBannerFailureCategory}"
                                                        SessionCorrelationId="{Binding StatusBannerSessionCorrelationId}"
                                                        LastConnectDuration="{Binding StatusBannerLastConnectDuration}"
                                                        LastHandshakeDuration="{Binding StatusBannerLastHandshakeDuration}"
                                                        BridgeState="{Binding StatusBannerBridgeState}"/>

                                    <Border Classes="appPanel"
                                            Padding="10"
                                            IsVisible="{Binding ShowTransientStatusPanel}">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <TextBlock Text="{Binding TransientBannerText}"
                                                       Classes="appMuted"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Classes="appButton secondaryButton"
                                                    Content="Cancel"
                                                    Command="{Binding CancelTransientCommand}"
                                                    IsVisible="{Binding CanCancelTransient}"
                                                    IsEnabled="{Binding CanCancelTransient}"
                                                    Height="34"
                                                    MinWidth="88"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Classes="appMuted"
                                               Text="{Binding HelperPageHelpText}"
                                               FontSize="16"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               MaxWidth="560"
                                               IsVisible="{Binding ShowMainControls}"/>

                                    <TextBox Classes="appInput highContrastInput codeDigitsInput"
                                             AutomationProperties.AutomationId="Helper.CodeInput"
                                             Text="{Binding CodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="HelperCodeInput_TextChanged"
                                             TextInput="HelperCodeInput_TextInput"
                                             KeyDown="HelperCodeInput_KeyDown"
                                             Watermark="123 456"
                                             MaxLength="7"
                                             TabIndex="0"
                                             Height="74"
                                             HorizontalAlignment="Stretch"
                                             IsEnabled="{Binding CanStartOrConnect}"
                                             IsVisible="{Binding ShowMainControls}"/>

                                    <Button Classes="appButton primaryButton action primaryAction"
                                            AutomationProperties.AutomationId="Helper.Connect"
                                            Content="Connect"
                                            TabIndex="1"
                                            Command="{Binding ConnectCommand}"
                                            IsEnabled="{Binding CanStartOrConnect}"
                                            IsVisible="{Binding ShowConnectAction}"/>

                                    <Button Classes="appButton secondaryButton action secondaryAction"
                                            Content="Retry"
                                            Command="{Binding RetryCommand}"
                                            IsVisible="{Binding ShowRetryAction}"/>

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="12"
                                                HorizontalAlignment="Center"
                                                IsVisible="{Binding ShowMainControls}">
                                        <Button Classes="linkButton linkAction"
                                                Content="They don't have nLink?"
                                                TabIndex="2"
                                                Command="{Binding CopyInstallMessageCommand}"/>
                                        <Button Classes="linkButton linkAction"
                                                Content="Use nFTP instead"
                                                TabIndex="3"
                                                Command="{Binding SendFileCommand}"/>
                                    </StackPanel>

                                    <TextBlock Classes="appMuted"
                                               Text="{Binding CopyFeedback.Text}"
                                               FontSize="14"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               IsVisible="{Binding ShowCopyFeedbackInline}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </views:SessionShellView.MainContent>

                    <views:SessionShellView.ChatContent>
                        <Border HorizontalAlignment="Stretch">
                            <views:ChatView HorizontalAlignment="Stretch"/>
                        </Border>
                    </views:SessionShellView.ChatContent>
                </views:SessionShellView>

                <Button Classes="appButton secondaryButton backAction"
                        Content="Back"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding ShowBackButton}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
