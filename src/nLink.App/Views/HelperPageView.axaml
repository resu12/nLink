<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.HelperPageView"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             x:DataType="vm:HelperPageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.highContrastInput">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}"/>
        </Style>

        <Style Selector="TextBox.helperConnectInput">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="18,0"/>
        </Style>

        <Style Selector="Button.primaryAction">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <Style Selector="Button.secondaryAction">
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style Selector="Button.compactSecondaryAction">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <Style Selector="Button.recentTargetButton">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style Selector="Button.linkAction">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style Selector="Button.backAction">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Margin="24">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="16">
                <views:SessionShellView RoleText="Helper"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ShowChatPaneRequested="{Binding ShowConnectedPanel}">
                    <views:SessionShellView.MainContent>
                        <Grid>
                            <views:ScreenShareSurfaceView x:Name="RemoteScreenShareSurface"
                                                          Frame="{Binding RemoteScreenShareFrame}"
                                                          CaptureEnabled="{Binding IsRemoteControlInputCaptureEnabled}"
                                                          KeyboardCaptureEnabled="{Binding IsRemoteControlKeyboardCaptureEnabled}"
                                                          MouseMoveRateHz="{Binding RemoteControlMouseMoveRateHz}"
                                                          RemoteControlInputProduced="ScreenShareSurfaceView_RemoteControlInputProduced"
                                                          RemoteControlHeldStateChanged="ScreenShareSurfaceView_RemoteControlHeldStateChanged"
                                                          ControlModeExitRequested="ScreenShareSurfaceView_ControlModeExitRequested"
                                                          IsVisible="{Binding ShowRemoteScreenShareFrame}"/>

                            <Border IsVisible="{Binding IsRemoteControlKeyboardCaptureEnabled}"
                                    IsHitTestVisible="False"
                                    Margin="2"
                                    BorderBrush="{StaticResource AppTextBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Opacity="0.5"/>

                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    Padding="10,6"
                                    Classes="appPanel"
                                    IsVisible="{Binding IsRemoteControlKeyboardCaptureEnabled}">
                                <TextBlock Text="Keyboard to remote (Esc to exit)"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <StackPanel IsVisible="{Binding ShowRemoteControlDebugToggle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="12"
                                        Spacing="6"
                                        MaxWidth="320">
                                <Button Classes="appButton secondaryButton"
                                        Content="{Binding RemoteControlDebugToggleText}"
                                        Command="{Binding ToggleRemoteControlDebugPanelCommand}"
                                        MinWidth="148"
                                        Height="28"
                                        HorizontalAlignment="Right"/>
                                <Border IsVisible="{Binding ShowRemoteControlDebugPanel}"
                                        Padding="10"
                                        Background="#CC111A24"
                                        BorderBrush="{StaticResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Remote control diagnostics"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsRoleText, StringFormat='role: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsControlStateText, StringFormat='state: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsControlModeText, StringFormat='control mode: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsDisplayText, StringFormat='display: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsCaptureFrameText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsMoveStatsText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsSuppressionsText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsLastMappedText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsVisible="{Binding ShowHelperMainContent}"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="620"
                                    MinWidth="420">
                                <StackPanel Spacing="16">
                                    <views:StatusBanner Status="{Binding BannerStatus}"
                                                        ForceVisible="{Binding ShowStatusBanner}"
                                                        DetailsText="{Binding StatusBannerDetailsText}"
                                                        CancelCommand="{Binding StatusBannerCancelCommand}"
                                                        FailureCategory="{Binding StatusBannerFailureCategory}"
                                                        SessionCorrelationId="{Binding StatusBannerSessionCorrelationId}"
                                                        LastConnectDuration="{Binding StatusBannerLastConnectDuration}"
                                                        LastHandshakeDuration="{Binding StatusBannerLastHandshakeDuration}"
                                                        BridgeState="{Binding StatusBannerBridgeState}"/>

                                    <Border Classes="appPanel"
                                            Padding="10"
                                            IsVisible="{Binding ShowTransientStatusPanel}">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <TextBlock Text="{Binding TransientBannerText}"
                                                       Classes="appMuted"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="1"
                                                    Classes="appButton secondaryButton"
                                                    Content="Cancel"
                                                    Command="{Binding CancelTransientCommand}"
                                                    IsVisible="{Binding CanCancelTransient}"
                                                    IsEnabled="{Binding CanCancelTransient}"
                                                    Height="34"
                                                    MinWidth="88"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource AppMutedPanelBrush}"
                                            CornerRadius="18"
                                            Padding="24"
                                            IsVisible="{Binding ShowMainControls}">
                                            <StackPanel Spacing="20">
                                                <Border Background="{StaticResource AppSurfaceBrush}"
                                                        CornerRadius="18"
                                                        Padding="20"
                                                        HorizontalAlignment="Stretch"
                                                        IsVisible="{Binding ShowMainControls}">
                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                          RowSpacing="16">
                                                        <TextBlock Text="Paste invite"
                                                                   Foreground="{StaticResource AppTextBrush}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Left"/>

                                                        <TextBox Grid.Row="1"
                                                                 Classes="appInput highContrastInput helperConnectInput"
                                                                 x:Name="HelperCodeInputBox"
                                                                 AutomationProperties.AutomationId="Helper.CodeInput"
                                                                 Text="{Binding CodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 KeyDown="HelperCodeInput_KeyDown"
                                                                 Watermark="Paste invite"
                                                                 TabIndex="0"
                                                                 Width="532"
                                                                 HorizontalAlignment="Center"
                                                                 IsEnabled="{Binding CanStartOrConnect}"/>

                                                        <Button Grid.Row="2"
                                                                Classes="appButton primaryButton action primaryAction"
                                                                AutomationProperties.AutomationId="Helper.Connect"
                                                                Content="Connect"
                                                                TabIndex="1"
                                                                Command="{Binding ConnectCommand}"
                                                                IsEnabled="{Binding CanStartOrConnect}"
                                                                IsVisible="{Binding ShowConnectAction}"/>

                                                        <Button Grid.Row="2"
                                                                Classes="appButton secondaryButton action secondaryAction"
                                                                Content="Retry"
                                                                Command="{Binding RetryCommand}"
                                                                IsVisible="{Binding ShowRetryAction}"/>

                                                        <StackPanel Grid.Row="3"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    Spacing="10">
                                                            <Button Classes="appButton secondaryButton compactSecondaryAction"
                                                                    AutomationProperties.AutomationId="Helper.PasteFromClipboard"
                                                                    Content="Paste invite"
                                                                    Width="160"
                                                                    Click="PasteFromClipboard_Click"/>
                                                            <Button Classes="appButton secondaryButton compactSecondaryAction"
                                                                    AutomationProperties.AutomationId="Helper.ScanQr"
                                                                    Content="Scan QR"
                                                                    Width="160">
                                                                <Button.Flyout>
                                                                    <MenuFlyout Placement="Bottom">
                                                                        <MenuItem Header="Scan from file"
                                                                                  Command="{Binding #Root.DataContext.ScanQrFromFileCommand}"/>
                                                                        <MenuItem Header="Scan with camera"
                                                                                  Command="{Binding #Root.DataContext.ScanQrFromCameraCommand}"/>
                                                                    </MenuFlyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                            <Border Classes="appPanel"
                                                    Padding="16"
                                                    IsVisible="{Binding ShowHelperVerificationCode}">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Verification code"
                                                               Classes="appMuted"
                                                               FontSize="12"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock AutomationProperties.AutomationId="Helper.VerificationCode"
                                                               Text="{Binding HelperVerificationCode}"
                                                               Foreground="{StaticResource AppTextBrush}"
                                                               FontSize="24"
                                                               FontWeight="SemiBold"
                                                               LetterSpacing="0.3"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Read this code to the helpee while waiting for approval."
                                                               Classes="appMuted"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               MaxWidth="420"/>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel HorizontalAlignment="Center"
                                                        IsVisible="{Binding ShowMainControls}">
                                                <Button Classes="linkButton linkAction"
                                                        AutomationProperties.AutomationId="Helper.CopyInstallLink"
                                                        Content="Copy install link"
                                                        TabIndex="2"
                                                        Command="{Binding CopyInstallMessageCommand}"/>
                                                <TextBlock AutomationProperties.AutomationId="Helper.CopyInstallFeedback"
                                                           Classes="appMuted"
                                                           Text="{Binding CopyFeedback.Text}"
                                                           FontSize="14"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Top"
                                                           MinHeight="20"
                                                           Margin="0,6,0,0"
                                                           MaxWidth="380"/>
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </views:SessionShellView.MainContent>

                    <views:SessionShellView.ChatContent>
                        <Border HorizontalAlignment="Stretch">
                            <views:ChatView HorizontalAlignment="Stretch"/>
                        </Border>
                    </views:SessionShellView.ChatContent>
                </views:SessionShellView>

                <Button Grid.Row="1"
                        Classes="appButton secondaryButton backAction"
                        Content="Back"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding ShowBackButton}"
                        Height="48"
                        MinWidth="200"
                        Opacity="0.92"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
