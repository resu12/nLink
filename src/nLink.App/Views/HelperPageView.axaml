<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.HelperPageView"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             x:DataType="vm:HelperPageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.highContrastInput">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}"/>
        </Style>

        <Style Selector="TextBox.helperConnectInput">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="LetterSpacing" Value="0"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style Selector="Border.inlineBadge">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.inlineBadgeText">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Margin="24">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="8">
                <views:SessionShellView RoleText="Helper"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        ShowChatPaneRequested="{Binding ShowConnectedPanel}">
                    <views:SessionShellView.MainContent>
                        <Grid VerticalAlignment="Top">
                            <views:ScreenShareSurfaceView x:Name="RemoteScreenShareSurface"
                                                          Frame="{Binding RemoteScreenShareFrame}"
                                                          SurfaceRole="helper_remote"
                                                          CursorOverlayVisible="{Binding ScreenShareViewer.CursorOverlayVisible}"
                                                          CursorOverlayNx="{Binding ScreenShareViewer.CursorOverlayNx}"
                                                          CursorOverlayNy="{Binding ScreenShareViewer.CursorOverlayNy}"
                                                          CaptureEnabled="{Binding IsRemoteControlInputCaptureEnabled}"
                                                          KeyboardCaptureEnabled="{Binding IsRemoteControlKeyboardCaptureEnabled}"
                                                          MouseMoveRateHz="{Binding RemoteControlMouseMoveRateHz}"
                                                          RemoteControlInputProduced="ScreenShareSurfaceView_RemoteControlInputProduced"
                                                          RemoteControlHeldStateChanged="ScreenShareSurfaceView_RemoteControlHeldStateChanged"
                                                          ControlModeExitRequested="ScreenShareSurfaceView_ControlModeExitRequested"
                                                          IsVisible="{Binding ShowRemoteScreenShareFrame}"/>

                            <Border IsVisible="{Binding IsRemoteControlKeyboardCaptureEnabled}"
                                    IsHitTestVisible="False"
                                    Margin="2"
                                    BorderBrush="{StaticResource AppTextBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Opacity="0.5"/>

                            <Border HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    Padding="10,6"
                                    Classes="appPanel"
                                    IsVisible="{Binding IsRemoteControlKeyboardCaptureEnabled}">
                                <TextBlock Text="Keyboard to remote (Esc to exit)"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <StackPanel IsVisible="{Binding ShowRemoteControlDebugToggle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="12"
                                        Spacing="6"
                                        MaxWidth="320">
                                <Button Classes="appButton secondaryButton compactButton"
                                        Content="{Binding RemoteControlDebugToggleText}"
                                        Command="{Binding ToggleRemoteControlDebugPanelCommand}"
                                        MinWidth="148"
                                        HorizontalAlignment="Right"/>
                                <Border IsVisible="{Binding ShowRemoteControlDebugPanel}"
                                        Padding="10"
                                        Background="#CC111A24"
                                        BorderBrush="{StaticResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Remote control diagnostics"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsRoleText, StringFormat='role: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsControlStateText, StringFormat='state: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsControlModeText, StringFormat='control mode: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsDisplayText, StringFormat='display: {0}'}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontSize="12"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsCaptureFrameText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsMoveStatsText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsSuppressionsText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding RemoteControlDiagnosticsLastMappedText}"
                                                   Classes="appMuted"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsVisible="{Binding ShowHelperMainContent}"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    MaxWidth="620"
                                    MinWidth="620">
                                <StackPanel Spacing="12">
                                    <views:StatusBanner Status="{Binding BannerStatus}"
                                                        ForceVisible="{Binding ShowStatusBanner}"
                                                        DetailsText="{Binding StatusBannerDetailsText}"
                                                        CancelCommand="{Binding StatusBannerCancelCommand}"
                                                        FailureCategory="{Binding StatusBannerFailureCategory}"
                                                        SessionCorrelationId="{Binding StatusBannerSessionCorrelationId}"
                                                        LastConnectDuration="{Binding StatusBannerLastConnectDuration}"
                                                        LastHandshakeDuration="{Binding StatusBannerLastHandshakeDuration}"
                                                        BridgeState="{Binding StatusBannerBridgeState}"/>

                                    <Border Classes="appPanel"
                                            Padding="10"
                                            IsVisible="{Binding ShowTransientStatusPanel}">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <TextBlock Text="{Binding TransientBannerText}"
                                                       Classes="appMuted"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>

                                    <Button Grid.Column="1"
                                                    Classes="appButton secondaryButton compactButton"
                                                    Content="Cancel"
                                                    Command="{Binding CancelTransientCommand}"
                                                    IsVisible="{Binding CanCancelTransient}"
                                                    IsEnabled="{Binding CanCancelTransient}"
                                                    MinWidth="88"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource AppSurfaceBrush}"
                                            BorderBrush="{StaticResource AppCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12"
                                            HorizontalAlignment="Center"
                                            MaxWidth="520"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding ShowSessionVerificationCode}">
                                        <StackPanel Spacing="6"
                                                    HorizontalAlignment="Stretch">
                                            <TextBlock AutomationProperties.AutomationId="Helper.SessionVerification.Title"
                                                       Text="Session verification"
                                                       Foreground="{StaticResource AppTextBrush}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock AutomationProperties.AutomationId="Helper.SessionVerification.EmojiSequence"
                                                       Text="{Binding SessionVerificationEmojiSequence}"
                                                       Foreground="{StaticResource AppTextBrush}"
                                                       FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                       FontSize="22"
                                                       LineHeight="30"
                                                       TextWrapping="NoWrap"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       MaxWidth="460"/>
                                            <TextBlock AutomationProperties.AutomationId="Helper.SessionVerification.FallbackCode"
                                                       Text="{Binding SessionVerificationFallbackCode}"
                                                       Foreground="{StaticResource AppAccentBrush}"
                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Compare this code on both screens."
                                                       Classes="appCaption"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       MaxWidth="460"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource AppMutedPanelBrush}"
                                            BorderBrush="{StaticResource AppCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="28"
                                            IsVisible="{Binding ShowFailurePanel}">
                                        <StackPanel Spacing="14"
                                                    HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding FailureTitle}"
                                                       Classes="appSectionTitle"
                                                       FontSize="24"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="460"/>

                                            <TextBlock Text="{Binding FailureMessage}"
                                                       Classes="appStatusText"
                                                       FontSize="16"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="520"/>

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="12"
                                                        HorizontalAlignment="Center">
                                                <Button Classes="appButton secondaryButton compactSecondaryAction"
                                                        Content="{Binding FailureActionText}"
                                                        Command="{Binding RetryCommand}"
                                                        MinWidth="136"
                                                        IsVisible="{Binding ShowRetryAction}"/>
                                                <Button Classes="appButton secondaryButton compactSecondaryAction"
                                                        Content="Open diagnostics"
                                                        Command="{Binding OpenDiagnosticsCommand}"
                                                        MinWidth="160"
                                                        IsVisible="{Binding ShowOpenDiagnosticsLink}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource AppMutedPanelBrush}"
                                            BorderBrush="{StaticResource AppCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="24"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding HasPendingHelpRequest}">
                                        <StackPanel Spacing="14">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Accept this help request?"
                                                           AutomationProperties.AutomationId="Helper.IncomingRequestTitle"
                                                           Classes="appSectionTitle"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="420"/>
                                                <TextBlock AutomationProperties.AutomationId="Helper.IncomingRequestText"
                                                           Text="{Binding IncomingHelpRequestText}"
                                                           Classes="appMuted"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="460"/>
                                                <TextBlock AutomationProperties.AutomationId="Helper.IncomingRequestTimer"
                                                           Text="{Binding IncomingHelpRequestTimeoutText}"
                                                           Classes="appMuted"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="460"
                                                           IsVisible="{Binding ShowIncomingHelpRequestTimeout}"/>
                                            </StackPanel>

                                            <Grid ColumnDefinitions="*,*"
                                                  ColumnSpacing="10">
                                                <Button Grid.Column="0"
                                                        Classes="appButton positiveButton action"
                                                        AutomationProperties.AutomationId="Helper.AcceptHelpRequest"
                                                        Content="Accept"
                                                        Command="{Binding AcceptHelpRequestCommand}"/>
                                                <Button Grid.Column="1"
                                                        Classes="appButton secondaryButton action"
                                                        AutomationProperties.AutomationId="Helper.RejectHelpRequest"
                                                        Content="Decline"
                                                        Command="{Binding RejectHelpRequestCommand}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                        <Border Background="{StaticResource AppMutedPanelBrush}"
                                                BorderBrush="{StaticResource AppCardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="24"
                                                VerticalAlignment="Top"
                                                IsVisible="{Binding ShowHelperSetupPanel}">
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="12"
                                                            IsVisible="{Binding ShowHelperIdentityBootstrapPanel}">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="10">
                                                        <TextBlock Text="Share your helper address"
                                                                   Classes="appSectionTitle"
                                                                   HorizontalAlignment="Left"
                                                                   TextAlignment="Left"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding ShowFirstPillVerificationCode}">
                                                            <Border Classes="inlineBadge">
                                                                <TextBlock Classes="inlineBadgeText"
                                                                           AutomationProperties.AutomationId="Helper.FirstPillVerificationCode"
                                                                           Text="{Binding FirstPillVerificationCodeText}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid>
                                                        <TextBox Classes="appInput highContrastInput helperConnectInput"
                                                                 AutomationProperties.AutomationId="Helper.HelperIdentityBootstrapTextBox"
                                                                 Text="{Binding HelperIdentityBootstrapText}"
                                                                 Watermark="{Binding HelperIdentityBootstrapWatermarkText}"
                                                                 IsReadOnly="True"
                                                                 HorizontalAlignment="Stretch"
                                                                 Padding="16,0,48,0"
                                                                 MinWidth="0"/>

                                                        <Button Classes="linkButton linkAction"
                                                                AutomationProperties.AutomationId="Helper.RegenerateHelperIdentity"
                                                                AutomationProperties.Name="{Binding RegenerateHelperIdentityButtonText}"
                                                                Content="↻"
                                                                Command="{Binding RegenerateHelperIdentityCommand}"
                                                                IsVisible="{Binding ShowRegenerateHelperIdentityAction}"
                                                                IsEnabled="{Binding CanRegenerateHelperIdentity}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Width="40"
                                                                MinWidth="40"
                                                                Margin="0,0,8,0"/>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="*,*"
                                                          ColumnSpacing="12"
                                                          HorizontalAlignment="Stretch">
                                                        <Button Grid.Column="0"
                                                                Classes="appButton primaryButton standardButton"
                                                                AutomationProperties.AutomationId="Helper.CopyHelperIdentity"
                                                                Content="Copy helper address"
                                                                Command="{Binding CopyHelperIdentityCommand}"
                                                                IsEnabled="{Binding HasReadyHelperIdentityBootstrapText}"
                                                                HorizontalAlignment="Stretch"
                                                                MinWidth="0"/>
                                                        <Button Grid.Column="1"
                                                                Classes="appButton primaryButton standardButton"
                                                                AutomationProperties.AutomationId="Helper.ShareHelperIdentity"
                                                                Content="Share helper address"
                                                                Command="{Binding ShareHelperIdentityCommand}"
                                                                IsEnabled="{Binding HasReadyHelperIdentityBootstrapText}"
                                                                HorizontalAlignment="Stretch"
                                                                MinWidth="0"/>
                                                    </Grid>

                                                    <Border Background="{StaticResource AppSurfaceBrush}"
                                                            BorderBrush="{StaticResource AppCardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12"
                                                            HorizontalAlignment="Center">
                                                        <Grid Width="224"
                                                              Height="224">
                                                            <Border Background="{StaticResource AppMutedPanelBrush}"
                                                                    CornerRadius="10"
                                                                    IsVisible="{Binding ShowHelperBootstrapQrPlaceholder}">
                                                                <TextBlock Text="QR code appears here"
                                                                           Classes="appMuted"
                                                                           FontSize="14"
                                                                           TextAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Image Source="{Binding HelperBootstrapQrImage}"
                                                                   Width="224"
                                                                   Height="224"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center"
                                                                   IsVisible="{Binding ShowHelperBootstrapQr}"/>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel HorizontalAlignment="Center"
                                                                Margin="0,-2,0,0">
                                                        <Button Classes="linkButton linkAction"
                                                                AutomationProperties.AutomationId="Helper.CopyInstallLink"
                                                                Content="Copy install link"
                                                                TabIndex="2"
                                                                Command="{Binding CopyInstallMessageCommand}"/>
                                                        <TextBlock AutomationProperties.AutomationId="Helper.CopyInstallFeedback"
                                                                   Classes="appCaption"
                                                                   Text="{Binding CopyFeedback.Text}"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Top"
                                                                   MinHeight="20"
                                                                   Margin="0,6,0,0"
                                                                   MaxWidth="380"/>
                                                    </StackPanel>

                                                    <Button Classes="appButton secondaryButton action secondaryAction"
                                                            Content="Retry"
                                                            Command="{Binding RetryCommand}"
                                                            IsVisible="{Binding ShowRetryAction}"/>
                                                </StackPanel>

                                            </StackPanel>
                                        </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </views:SessionShellView.MainContent>

                    <views:SessionShellView.ChatContent>
                        <Border HorizontalAlignment="Stretch">
                            <views:ChatView HorizontalAlignment="Stretch"/>
                        </Border>
                    </views:SessionShellView.ChatContent>
                </views:SessionShellView>

                <Button Grid.Row="1"
                        Classes="appButton secondaryButton backAction footerButton"
                        Content="Back"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding ShowBackButton}"
                        Opacity="0.92"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
