<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             xmlns:views="using:NLink.App.Views"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.HelperPageView"
             x:DataType="vm:HelperPageViewModel">

    <UserControl.Styles>
        <Style Selector="TextBox.highContrastInput">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="Height" Value="64"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <Style Selector="Button.primaryAction">
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style Selector="Button.secondaryAction">
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <Style Selector="Button.linkAction">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style Selector="Button.backAction">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="24">
            <StackPanel HorizontalAlignment="Center"
                        MaxWidth="720"
                        Spacing="14">
                <TextBlock Classes="appTitle"
                           Text="{Binding PageTitle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <Border Classes="appCard"
                        Padding="24">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="appMuted"
                                   Text="{Binding HelperPageHelpText}"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   MaxWidth="560"/>

                        <TextBox Classes="appInput highContrastInput"
                                 Text="{Binding CodeInput, Mode=TwoWay}"
                                 Watermark="123 456"
                                 MaxLength="7"
                                 TabIndex="0"
                                 Height="62"
                                 FontSize="28"
                                 FontWeight="Bold"
                                 LetterSpacing="4"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 TextAlignment="Center"
                                 />

                        <Button Classes="appButton primaryButton action primaryAction"
                                Content="Connect"
                                TabIndex="1"
                                Command="{Binding ConnectCommand}"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="14"
                                    HorizontalAlignment="Center">
                            <Button Classes="linkButton linkAction"
                                    Content="They don't have nLink?"
                                    TabIndex="2"
                                    Command="{Binding CopyInstallMessageCommand}"/>

                            <Button Classes="linkButton linkAction"
                                    Content="Use nFTP instead"
                                    TabIndex="3"
                                    Command="{Binding SendFileCommand}"/>
                        </StackPanel>

                        <TextBlock Classes="appMuted"
                                   Text="{Binding CopyFeedbackText}"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding ShowCopyFeedback}"/>

                        <TextBlock Classes="appMuted"
                                   Text="{Binding StatusText}"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding ShowStatusText}"/>

                        <Border HorizontalAlignment="Center"
                                MinWidth="560"
                                MaxWidth="720"
                                IsVisible="{Binding ShowChatPanel}">
                            <views:ChatView HorizontalAlignment="Stretch"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Button Classes="appButton secondaryButton backAction"
                        Content="Back"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
