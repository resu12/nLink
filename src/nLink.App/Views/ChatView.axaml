<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.ChatView"
             x:Name="Root"
             x:DataType="vm:IChatPanelBindings">

    <UserControl.Styles>
        <Style Selector="Border.chatTopBar">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style Selector="Border.chatShell">
            <Setter Property="Background" Value="{StaticResource AppMutedPanelBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="Border.chatBubbleBase">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="Border.chatBubbleBase.remoteBubble">
            <Setter Property="Background" Value="#172133"/>
        </Style>

        <Style Selector="Border.chatBubbleBase.localBubble">
            <Setter Property="Background" Value="#21344D"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style Selector="TextBox.chatInput">
            <Setter Property="Background" Value="{StaticResource AppPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppInputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.transferCard">
            <Setter Property="Background" Value="#111A2A"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="ProgressBar.transferProgress">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}"/>
            <Setter Property="Background" Value="#1A2637"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="FileTransferCardTemplate"
                      x:DataType="vm:FileTransferPanelItemViewModel">
            <Border Classes="transferCard"
                    Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <StackPanel Grid.Column="0"
                                    Spacing="2">
                            <TextBlock Text="{Binding FileName}"
                                       Foreground="{StaticResource AppTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FileSizeText}"
                                       Classes="appMuted"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Foreground="{StaticResource AppMutedTextBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Top"
                                   TextAlignment="Right"/>
                    </Grid>

                    <StackPanel IsVisible="{Binding ShowProgress}"
                                Spacing="6">
                        <ProgressBar Classes="transferProgress"
                                     Value="{Binding ProgressFraction}"/>

                        <TextBlock Text="{Binding ProgressText}"
                                   Classes="appMuted"/>
                    </StackPanel>

                    <TextBlock Text="{Binding SavedLocationText}"
                               Classes="appMuted"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ShowSavedLocation}"/>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{Binding ShowActions}">
                        <Button AutomationProperties.AutomationId="Chat.FileTransfer.Accept"
                                Classes="appButton positiveButton"
                                Content="Accept"
                                Command="{Binding #Root.DataContext.AcceptIncomingFileCommand}"
                                CommandParameter="{Binding TransferId}"
                                IsVisible="{Binding ShowAccept}"
                                Height="34"
                                MinWidth="96"/>

                        <Button AutomationProperties.AutomationId="Chat.FileTransfer.Decline"
                                Classes="appButton secondaryButton"
                                Content="Decline"
                                Command="{Binding #Root.DataContext.DeclineIncomingFileCommand}"
                                CommandParameter="{Binding TransferId}"
                                IsVisible="{Binding ShowDecline}"
                                Height="34"
                                MinWidth="96"/>

                        <Button AutomationProperties.AutomationId="Chat.FileTransfer.Cancel"
                                Classes="appButton secondaryButton"
                                Content="Cancel"
                                Command="{Binding #Root.DataContext.CancelFileTransferCommand}"
                                CommandParameter="{Binding TransferId}"
                                IsVisible="{Binding ShowCancel}"
                                Height="34"
                                MinWidth="96"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="10"
          MinHeight="320">
        <Border Grid.Row="0"
                Classes="chatTopBar"
                IsVisible="{Binding ShowChatTopBar}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  VerticalAlignment="Center">
                <Grid Grid.Column="0"/>

                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="Chat.Disconnect"
                        Classes="appButton secondaryButton"
                        Content="Disconnect"
                        Command="{Binding EndSessionCommand}"
                        IsVisible="{Binding #Root.ShowInlineEndSession}"
                        IsEnabled="{Binding CanEndSession}"
                        Height="36"
                        MinWidth="104"
                        Padding="12,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="chatShell"
                MinHeight="360">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="2"
                  Margin="16,14">
                <StackPanel Grid.Row="0"
                            Spacing="0">
                    <TextBlock Classes="appMuted"
                               Text="{Binding ChatNoticeText}"
                               FontSize="14"
                               Margin="0,0,0,12"
                               IsVisible="{Binding ShowChatNotice}"/>

                    <ContentControl Content="{Binding InboundFileTransfer}"
                                    ContentTemplate="{StaticResource FileTransferCardTemplate}"/>

                    <ContentControl Content="{Binding OutboundFileTransfer}"
                                    ContentTemplate="{StaticResource FileTransferCardTemplate}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              x:Name="MessagesScrollViewer"
                              AutomationProperties.AutomationId="Chat.Messages"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <TextBlock Classes="appMuted"
                                   Text="No messages yet"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding ShowNoMessagesPlaceholder}"/>

                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChatLineViewModel">
                                    <Grid HorizontalAlignment="Stretch"
                                          Margin="0,0,0,12">
                                        <Border Classes="chatBubbleBase"
                                                MaxWidth="{Binding Bounds.Width, ElementName=MessagesScrollViewer, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.65}"
                                                Classes.remoteBubble="{Binding IsRemote}"
                                                Classes.localBubble="{Binding IsLocal}">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       Foreground="{StaticResource AppTextBrush}"
                                                       FontSize="16"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              VerticalAlignment="Center">
            <Button Grid.Column="0"
                    AutomationProperties.AutomationId="Chat.SendFile"
                    Classes="appButton secondaryButton"
                    Content="Send file"
                    Command="{Binding SendFileCommand}"
                    IsVisible="{Binding ShowSendFileAction}"
                    IsEnabled="{Binding CanSendFileAction}"
                    Height="48"
                    MinWidth="112"/>

            <TextBox Grid.Column="1"
                     x:Name="ChatInputTextBox"
                     AutomationProperties.AutomationId="Chat.Input"
                     Classes="chatInput"
                     Text="{Binding ChatDraft, Mode=TwoWay}"
                     IsEnabled="{Binding IsChatInputEnabled}"
                     Watermark="Type a message"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Stretch"
                     FontSize="16"/>

            <Button Grid.Column="2"
                    AutomationProperties.AutomationId="Chat.Send"
                    Classes="appButton primaryButton"
                    Content="Send"
                    Command="{Binding SendChatCommand}"
                    IsEnabled="{Binding IsChatInputEnabled}"
                    Width="104"
                    Height="48"/>
        </Grid>
    </Grid>
</UserControl>
