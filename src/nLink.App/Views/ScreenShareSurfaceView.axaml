<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:NLink.App.Views"
             x:Class="NLink.App.Views.ScreenShareSurfaceView"
             x:Name="Root">
    <Grid Background="Transparent">
        <Image x:Name="FrameImage"
               Source="{Binding Frame, ElementName=Root}"
               Stretch="Uniform"
               IsHitTestVisible="False"/>
        <Canvas x:Name="CursorOverlayLayer"
                IsHitTestVisible="False"
                IsVisible="{Binding CursorOverlayVisible, ElementName=Root}">
            <Path x:Name="CursorOverlayPointer"
                  Width="10"
                  Height="14"
                  Data="M0,0 L0,14 L3.2,10.2 L5.5,14 L7.8,13.2 L6.2,9.4 L10,9.4 Z"
                  Fill="White"
                  Stroke="#202020"
                  StrokeThickness="0.8"/>
        </Canvas>
    </Grid>
</UserControl>
