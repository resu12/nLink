<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:NLink.App.ViewModels"
             mc:Ignorable="d"
             x:Class="NLink.App.Views.DiagnosticsPageView"
             x:DataType="vm:DiagnosticsPageViewModel">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="24">
            <StackPanel HorizontalAlignment="Center"
                        MaxWidth="820"
                        Spacing="16">
                <TextBlock Classes="appTitle"
                           Text="{Binding PageTitle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Classes="appCaption"
                           Text="{Binding CopyFeedback.Text}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           IsVisible="{Binding CopyFeedback.IsVisible}"/>

                <TabControl HorizontalAlignment="Stretch">
                    <TabItem Header="Settings">
                        <StackPanel Spacing="16"
                                    Margin="0,16,0,0">
                            <Border Classes="appCard" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="appSectionTitle" Text="Screen share settings"/>
                                    <TextBlock Classes="appMuted" Text="{Binding AdvancedScreenShareSettingsSummary}" TextWrapping="Wrap"/>
                                    <TextBlock Classes="appMuted"
                                               Text="A custom or migrated screen share preset is active. Apply Balanced to return to the default support baseline."
                                               IsVisible="{Binding ShowScreenShareResetHint}"
                                               TextWrapping="Wrap"/>
                                    <Grid ColumnDefinitions="170,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          RowSpacing="8"
                                          ColumnSpacing="12"
                                          Margin="0,4,0,0">
                                        <Button Grid.Row="0"
                                                Grid.Column="0"
                                                Classes="appButton secondaryButton compactButton"
                                                Content="Balanced"
                                                Command="{Binding ApplyBalancedScreenSharePresetCommand}"/>
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Classes="appMuted"
                                                   Text="{Binding ScreenSharePresetBalanced}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Row="1"
                                                Grid.Column="0"
                                                Classes="appButton secondaryButton compactButton"
                                                Content="High quality"
                                                Command="{Binding ApplyHighQualityScreenSharePresetCommand}"/>
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Classes="appMuted"
                                                   Text="{Binding ScreenSharePresetHighQuality}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Row="2"
                                                Grid.Column="0"
                                                Classes="appButton secondaryButton compactButton"
                                                Content="Tuna quality"
                                                Command="{Binding ApplyTunaQualityScreenSharePresetCommand}"/>
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Classes="appMuted"
                                                   Text="{Binding ScreenSharePresetTunaQuality}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Row="3"
                                                Grid.Column="0"
                                                Classes="appButton secondaryButton compactButton"
                                                Content="High performance"
                                                Command="{Binding ApplyHighPerformanceScreenSharePresetCommand}"/>
                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   Classes="appMuted"
                                                   Text="{Binding ScreenSharePresetHighPerformance}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Classes="appMuted"
                                               Text="Tuna quality uses more bandwidth and is recommended when Tuna acceleration is enabled. Current NKN remains available and may auto-reduce quality if delivery is congested."
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Classes="appMuted"
                                               Text="{Binding ScreenShareCaptureEnvHint}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Wallet">
                        <StackPanel Spacing="16"
                                    Margin="0,16,0,0">
                            <Border Classes="appCard" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="appSectionTitle" Text="Tuna (experimental)"/>
                                    <TextBlock Classes="appBody"
                                               Text="Tuna can speed up screen sharing and file transfers by opening an encrypted high-performance NKN relay path after a session is approved. This computer pays only when its wallet is unlocked and selected as the listener; if Tuna is unavailable, nLink keeps using regular NKN automatically."
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="appCard" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="appSectionTitle" Text="Wallet and runtime"/>
                                    <Grid ColumnDefinitions="220,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          RowSpacing="8"
                                          ColumnSpacing="12">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="appMuted" Text="Runtime flag"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="appMuted" Text="{Binding TunaRuntimeFlagStatus}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="appMuted" Text="Current Tuna state"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="appMuted" Text="{Binding TunaCurrentState}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="appMuted" Text="Startup timing"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="appMuted" Text="{Binding TunaStartupTiming}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="appMuted" Text="Unlock"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="appMuted" Text="{Binding TunaRuntimeUnlockStatus}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="appMuted" Text="Fallback"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="appMuted" Text="{Binding TunaFallbackState}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="appMuted" Text="Verifier"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Classes="appMuted" Text="{Binding TunaSidecarVerifierStatus, StringFormat='{}{0}'}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Classes="appMuted" Text="Sidecar"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Classes="appMuted" Text="{Binding TunaSidecarVerifierDetail}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Classes="appMuted" Text="Wallet"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Classes="appMuted" Text="{Binding TunaWalletFileName}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Classes="appMuted" Text="Status"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" Classes="appMuted" Text="{Binding TunaWalletStatus}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="9" Grid.Column="0" Classes="appMuted" Text="Balance"/>
                                        <TextBlock Grid.Row="9" Grid.Column="1" Classes="appMuted" Text="{Binding TunaWalletBalance}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="10" Grid.Column="0" Classes="appMuted" Text="Last verified"/>
                                        <TextBlock Grid.Row="10" Grid.Column="1" Classes="appMuted" Text="{Binding TunaWalletLastVerified}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="11" Grid.Column="0" Classes="appMuted" Text="Spent by nLink"/>
                                        <TextBlock Grid.Row="11" Grid.Column="1" Classes="appMuted" Text="{Binding TunaSpendByNLink}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="12" Grid.Column="0" Classes="appMuted" Text="Average cost"/>
                                        <TextBlock Grid.Row="12" Grid.Column="1" Classes="appMuted" Text="{Binding TunaAverageCost}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="13" Grid.Column="0" Classes="appMuted" Text="Last session cost"/>
                                        <TextBlock Grid.Row="13" Grid.Column="1" Classes="appMuted" Text="{Binding TunaLastSessionCost}" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="14" Grid.Column="0" Classes="appMuted" Text="Last session reason"/>
                                        <TextBlock Grid.Row="14" Grid.Column="1" Classes="appMuted" Text="{Binding TunaLastSessionReason}" TextWrapping="Wrap"/>
                                    </Grid>

                                    <StackPanel Spacing="8">
                                        <CheckBox Content="Enable Tuna acceleration (experimental)"
                                                  IsChecked="{Binding IsTunaRuntimeEnabled}"/>
                                        <WrapPanel>
                                            <CheckBox Content="File lane"
                                                      IsChecked="{Binding IsTunaFileLaneEnabled}"
                                                      IsEnabled="{Binding IsTunaRuntimeEnabled}"
                                                      Margin="0,0,14,8"/>
                                            <CheckBox Content="Screen lane"
                                                      IsChecked="{Binding IsTunaScreenLaneEnabled}"
                                                      IsEnabled="{Binding IsTunaRuntimeEnabled}"
                                                      Margin="0,0,14,8"/>
                                        </WrapPanel>
                                        <Grid ColumnDefinitions="*,*,*"
                                              ColumnSpacing="8">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Classes="appMuted" Text="Max NKN/MB"/>
                                                <TextBox Text="{Binding TunaMaxPriceNknPerMb}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Classes="appMuted" Text="Max MiB"/>
                                                <TextBox Text="{Binding TunaMaxTotalMiB}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4">
                                                <TextBlock Classes="appMuted" Text="Max minutes"/>
                                                <TextBox Text="{Binding TunaMaxDurationMinutes}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Classes="appMuted"
                                                   Text="{Binding TunaRuntimePayerNotice}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Classes="appPanel"
                                            Background="{StaticResource AppMutedPanelBrush}"
                                            Padding="10">
                                        <TextBlock Text="{Binding TunaWalletAddress}"
                                                   Foreground="{StaticResource AppTextBrush}"
                                                   FontFamily="Cascadia Mono,Consolas,Monaco,monospace"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Classes="appMuted"
                                               Text="{Binding TunaWalletLastFailure, StringFormat='Last failure: {0}'}"
                                               FontSize="12"
                                               IsVisible="{Binding ShowTunaWalletFailure}"
                                               TextWrapping="Wrap"/>

                                    <Grid ColumnDefinitions="*,*,*"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="8"
                                          RowSpacing="8">
                                        <Button Grid.Column="0"
                                                Grid.Row="0"
                                                Classes="appButton secondaryButton compactButton"
                                                Content="Link wallet.json"
                                                Command="{Binding LinkTunaWalletCommand}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1"
                                                Grid.Row="0"
                                                Classes="appButton secondaryButton compactButton"
                                                Content="Validate balance"
                                                Command="{Binding ValidateTunaWalletCommand}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="2"
                                                Grid.Row="0"
                                                Classes="appButton secondaryButton compactButton"
                                                Content="Unlock for this session"
                                                Command="{Binding UnlockTunaRuntimeCommand}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="0"
                                                Grid.Row="1"
                                                Classes="appButton secondaryButton compactButton"
                                                Content="Copy address"
                                                Command="{Binding CopyTunaWalletAddressCommand}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1"
                                                Grid.Row="1"
                                                Classes="appButton secondaryButton compactButton"
                                                Content="Unlink"
                                                Command="{Binding UnlinkTunaWalletCommand}"
                                                HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Diagnostics">
                        <StackPanel Spacing="16"
                                    Margin="0,16,0,0">
                            <Border Classes="appCard" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Privacy notice"
                                               Classes="appSectionTitle"/>
                                    <TextBlock Classes="appBody"
                                               Text="{Binding DiagnosticsPrivacyNotice}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        AutomationProperties.AutomationId="Diag.Copy"
                                        Classes="appButton secondaryButton standardButton"
                                        Content="Copy diagnostics"
                                        Command="{Binding CopyReliabilityLogCommand}"
                                        HorizontalAlignment="Stretch"/>

                                <Button Grid.Column="1"
                                        Classes="appButton secondaryButton standardButton"
                                        Content="Save Hang Report"
                                        Command="{Binding SaveHangReportCommand}"
                                        HorizontalAlignment="Stretch"/>

                                <Button Grid.Column="2"
                                        AutomationProperties.AutomationId="Diag.OpenLogs"
                                        Classes="appButton secondaryButton standardButton"
                                        Content="Open logs folder"
                                        Command="{Binding OpenLogsFolderCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>

                            <Border Classes="appCard" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Health"
                                               Classes="appSectionTitle"/>

                                    <Grid ColumnDefinitions="220,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          RowSpacing="8"
                                          ColumnSpacing="12">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="appLabel" Text="Version"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="appBody" Text="{Binding AppVersion}" FontSize="16"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="appLabel" Text="Connection"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="appBody" Text="{Binding ConnectionStateSummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="appLabel" Text="Authorization"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="appBody" Text="{Binding AuthorizationSummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="appLabel" Text="Screen share"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareSummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="appLabel" Text="Remote control"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="appBody" Text="{Binding RemoteControlSummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="appLabel" Text="File transfer"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Classes="appBody" Text="{Binding FileTransferSummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Classes="appLabel" Text="Persistence"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Classes="appBody" Text="{Binding PersistenceSummary}" FontSize="16" TextWrapping="Wrap"/>
                                    </Grid>

                                    <TextBlock Classes="appLabel" Text="Last error"/>
                                    <Border Classes="appPanel"
                                            Background="{StaticResource AppMutedPanelBrush}"
                                            Padding="12">
                                        <TextBlock Text="{Binding ConnectionErrorSummary}"
                                                   Foreground="{StaticResource AppBodyTextBrush}"
                                                   FontFamily="Cascadia Mono,Consolas,Monaco,monospace"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Classes="appCard" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Connection &amp; identity"
                                               Classes="appSectionTitle"/>

                                    <Grid ColumnDefinitions="220,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          RowSpacing="8"
                                          ColumnSpacing="12">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="appLabel" Text="Transport"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="appBody" Text="{Binding ActiveTransport}" FontSize="16"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="appLabel" Text="Helper identity"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="appBody" Text="{Binding HelperIdentitySummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="appLabel" Text="Authoritative address"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="appBody" Text="{Binding AuthoritativeConnectedAddress}" FontSize="16"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="appLabel" Text="External topology"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareEvidenceExternalTopologySummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="appLabel" Text="Last rejected message"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="appBody" Text="{Binding LastRejectedMessageSummary}" FontSize="16" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="appCard" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Screen share health"
                                               Classes="appSectionTitle"/>

                                    <Grid ColumnDefinitions="220,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          RowSpacing="8"
                                          ColumnSpacing="12">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="appLabel" Text="Live state"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareLiveState}" FontSize="16"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="appLabel" Text="Live profile"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareLiveProfileSummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="appLabel" Text="Live performance"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareLivePerformanceSummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="appLabel" Text="CPU / preprocess"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareLiveCpuSummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="appLabel" Text="Cursor"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareLiveCursorSummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="appLabel" Text="Visual safety"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareLiveVisualSafetySummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Classes="appLabel" Text="Latest artifact"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareEvidenceArtifactName}" FontSize="16"/>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Classes="appLabel" Text="Latest quality"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareEvidenceQualitySummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Classes="appLabel" Text="Latest low-FPS"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareEvidenceLowFpsSummary}" FontSize="16" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="9" Grid.Column="0" Classes="appLabel" Text="Latest verdict"/>
                                        <TextBlock Grid.Row="9" Grid.Column="1" Classes="appBody" Text="{Binding ScreenShareEvidenceVerdict}" FontSize="16" TextWrapping="Wrap"/>
                                    </Grid>

                                    <TextBlock Classes="appMuted"
                                               Text="{Binding ScreenShareEvidenceSummary}"
                                               FontSize="13"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Classes="appCard" Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="appSectionTitle" Text="Raw counters"/>
                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto,Auto,Auto"
                                              RowSpacing="8"
                                              ColumnSpacing="12">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="appMuted" Text="Messages sent"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="appMuted" Text="{Binding MessagesSent}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="appMuted" Text="Messages received"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="appMuted" Text="{Binding MessagesReceived}"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="appMuted" Text="Screen share lane"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="appMuted" Text="{Binding ScreenShareMessagesSent, StringFormat='messages={0}'}"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="appMuted" Text="High-priority queue"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="appMuted" Text="{Binding HighPriorityControlQueueOverflows, StringFormat='overflows={0}'}"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="appSectionTitle" Text="Bridge"/>
                                        <TextBlock Classes="appMuted" Text="{Binding BridgePid, StringFormat='PID: {0}'}"/>
                                        <TextBlock Classes="appMuted" Text="{Binding NodeSdk, StringFormat='Node/SDK: {0}'}"/>
                                        <TextBlock Classes="appMuted" Text="{Binding LastHeartbeat, StringFormat='Last heartbeat: {0}'}"/>
                                        <TextBlock Classes="appMuted" Text="{Binding LastBridgeExit, StringFormat='Last exit: {0}'}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="appSectionTitle" Text="Recent connection attempts"/>
                                        <Border Classes="appPanel"
                                                Background="{StaticResource AppMutedPanelBrush}"
                                                Padding="10">
                                            <ScrollViewer MaxHeight="180"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{Binding RecentConnectionAttemptsText}"
                                                           Foreground="{StaticResource AppTextBrush}"
                                                           FontFamily="Cascadia Mono,Consolas,Monaco,monospace"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="10">
                                        <Button Grid.Column="0"
                                                Classes="appButton secondaryButton standardButton"
                                                Content="Export metrics JSON"
                                                Command="{Binding ExportMetricsJsonCommand}"/>
                                        <Button Grid.Column="1"
                                                Classes="appButton secondaryButton standardButton"
                                                Content="Report a bug"
                                                Command="{Binding ReportBugCommand}"
                                                IsVisible="{Binding ShowReportBug}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <Button Classes="appButton secondaryButton standardButton"
                        Content="Back"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Center"
                        MinWidth="180"
                        Margin="0,4,0,0"/>

                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                    <TextBlock Classes="appMuted"
                               Text="Powered by"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button Classes="linkButton linkAction"
                            Content="NKN"
                            Click="PoweredByNknLink_Click"
                            FontSize="12"
                            Padding="4,0"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
