<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="NLink.App.Views.SendFileWindow"
        Title="Send file"
        Width="980"
        Height="760"
        MinWidth="760"
        MinHeight="560"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Background="{StaticResource AppBackgroundBrush}" RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Margin="20,20,20,12"
                Padding="16"
                Classes="appCard"
                CornerRadius="12">
            <StackPanel Spacing="4"
                        HorizontalAlignment="Center"
                        MaxWidth="620">
                <TextBlock Text="Send file"
                           Classes="appSectionTitle"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="1) Choose the helpee file"
                           Foreground="{StaticResource AppBodyTextBrush}"
                           FontSize="16"
                           FontWeight="Normal"
                           TextAlignment="Center"/>
                <TextBlock Text="2) Send"
                           Foreground="{StaticResource AppBodyTextBrush}"
                           FontSize="16"
                           FontWeight="Normal"
                           TextAlignment="Center"/>
                <TextBlock Text="3) Copy the link and send it to them"
                           Foreground="{StaticResource AppBodyTextBrush}"
                           FontSize="16"
                           FontWeight="Normal"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,0,20,12">
            <Border x:Name="SurfaceBorder"
                    Classes="appPanel"
                    CornerRadius="12"
                    Padding="6">
                <ContentControl x:Name="WebContentHost"/>
            </Border>

            <Border x:Name="FallbackOverlay"
                    IsVisible="False"
                    Classes="appCard"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="560"
                            Spacing="12">
                    <TextBlock x:Name="FallbackTitleText"
                               Text="Opening nFTP in your browser..."
                               Classes="appSectionTitle"
                               TextAlignment="Center"/>

                    <TextBlock x:Name="FallbackMessageText"
                               Text="Embedded web view is not available."
                               Foreground="{StaticResource AppBodyTextBrush}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <Border Classes="appPanel"
                            CornerRadius="10"
                            Padding="10,8">
                        <TextBlock Text="https://nftp.nkn.org"
                                   Foreground="{StaticResource AppBodyTextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Button Classes="appButton secondaryButton action"
                            Content="Open nFTP in browser"
                            Click="OpenInBrowser_Click"
                            Width="420"
                            />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="20,0,20,20"
                Classes="appPanel"
                CornerRadius="12"
                Padding="12">
            <Button Classes="appButton secondaryButton action footerButton"
                    Content="Back"
                    Click="Back_Click"
                    Width="220"/>
        </Border>
    </Grid>
</Window>
