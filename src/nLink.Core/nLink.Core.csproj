    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>nLink.Core</AssemblyName>
    <RootNamespace>NLink.Core</RootNamespace>
    <Product>nLink</Product>
